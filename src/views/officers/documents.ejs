<%- include('../partials/header', { activeMenu: typeof activeMenu !== 'undefined' ? activeMenu : 'officers' }) %>
<%- include('../partials/flash') %>

<% function fmtDate(d) { return d ? new Date(d).toLocaleDateString('vi-VN') : '-'; } %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h5 class="fw-bold mb-0"><i class="fas fa-file-pdf text-danger me-2"></i>Hồ sơ điện tử & Tài liệu: <%= officer.hoTen %></h5>
  <div class="d-flex gap-2">
    <% if (typeof canUpload !== 'undefined' && canUpload) { %>
    <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#uploadDocModal">
      <i class="fas fa-upload me-1"></i>Tải lên tài liệu mới
    </button>
    <% } %>
    <a href="/officers/<%= officer._id %>" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-left me-1"></i>Quay lại hồ sơ</a>
  </div>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0 align-middle">
        <thead class="table-light">
          <tr>
            <th class="ps-3">Tên tài liệu</th>
            <th>Loại</th>
            <th>Ngày cấp</th>
            <th>Người tải lên</th>
            <th class="text-end pe-3">Thao tác</th>
          </tr>
        </thead>
        <tbody>
          <% if (typeof documents !== 'undefined' && documents.length > 0) { %>
            <% documents.forEach(doc => { %>
            <tr>
              <td class="ps-3 fw-medium small"><%= doc.tenTaiLieu %></td>
              <td><span class="badge bg-secondary"><%= doc.loaiTaiLieu %></span></td>
              <td><small><%= fmtDate(doc.ngayCap) %></small></td>
              <td><small><%= doc.nguoiTaiLen ? doc.nguoiTaiLen.hoTen : '-' %></small></td>
              <td class="text-end pe-3">
                <% if (doc.fileUrls && doc.fileUrls.length > 0) { %>
                <% doc.fileUrls.forEach((url, idx) => { %>
                  <button type="button" class="btn btn-sm btn-outline-info me-1" title="Xem file <%= idx + 1 %>" onclick="viewDocument('<%= url %>', '<%= doc.tenTaiLieu %> (File <%= idx + 1 %>)')"><i class="fas fa-eye"></i> <%= doc.fileUrls.length > 1 ? (idx + 1) : '' %></button>
                <% }) %>
              <% } else if (doc.fileUrl) { %>
                <button type="button" class="btn btn-sm btn-outline-info me-1" title="Xem tài liệu" onclick="viewDocument('<%= doc.fileUrl %>', '<%= doc.tenTaiLieu %>')"><i class="fas fa-eye"></i></button>
              <% } %>
              <%
                // canEdit = admin/truong/pho: xoa duoc tat ca
                // cbcs: chi xoa tai lieu chinh minh upload
                let canDeleteThis = canEdit;
                if (!canEdit && canUpload) {
                  // cbcs xem ho so cua minh: kiem tra nguoiTaiLen
                  canDeleteThis = doc.nguoiTaiLen && 
                    currentUser && 
                    doc.nguoiTaiLen._id && 
                    doc.nguoiTaiLen._id.toString() === currentUser._id.toString();
                }
              %>
              <% if (canDeleteThis) { %>
              <form action="/documents/<%= doc._id %>?_method=DELETE" method="POST" class="d-inline delete-form" data-confirm="Xác nhận xóa tài liệu này vĩnh viễn?">
                <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa"><i class="fas fa-trash"></i></button>
              </form>
              <% } %>
              </td>
            </tr>
            <% }) %>
          <% } else { %>
            <tr><td colspan="5" class="text-center text-muted py-4 small">Chưa có tài liệu đính kèm</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Modal Upload Document -->
<div class="modal fade" id="uploadDocModal" tabindex="-1">
  <div class="modal-dialog">
    <form action="/documents" method="POST" enctype="multipart/form-data" class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title fw-bold">Tải lên hồ sơ điện tử</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <input type="hidden" name="officer" value="<%= officer._id %>">
        
        <div class="mb-3">
          <label class="form-label fw-semibold small">Tên tài liệu <span class="text-danger">*</span></label>
          <input type="text" name="tenTaiLieu" class="form-control" required placeholder="VD: Quyết định thăng cấp bậc hàm Đại úy">
        </div>
        
        <div class="mb-3">
          <label class="form-label fw-semibold small">Loại tài liệu <span class="text-danger">*</span></label>
          <select name="loaiTaiLieu" class="form-select" required>
            <option value="Quyết định">Quyết định</option>
            <option value="Bằng cấp/Chứng chỉ">Bằng cấp/Chứng chỉ</option>
            <option value="Căn cước công dân">Căn cước công dân</option>
            <option value="Hồ sơ lý lịch">Hồ sơ lý lịch</option>
            <option value="Khác">Khác</option>
          </select>
        </div>

        <div class="mb-3">
          <label class="form-label fw-semibold small">Ngày cấp (nếu có)</label>
          <input type="date" name="ngayCap" class="form-control">
        </div>
        
        <div class="mb-3">
          <label class="form-label fw-semibold small">Chọn file(s) <span class="text-danger">*</span></label>
          <input type="file" name="files" class="form-control" required multiple accept=".pdf,.jpg,.jpeg,.png">
          <div class="form-text">Hỗ trợ chọn nhiều file (PDF, JPG, PNG). Tối đa 5MB mỗi file.</div>
        </div>
      </div>
      <div class="modal-footer bg-light">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
        <button type="submit" class="btn btn-primary"><i class="fas fa-upload me-2"></i>Tải lên</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal Viewer -->
<div class="modal fade" id="documentViewerModal" tabindex="-1">
  <div class="modal-dialog modal-xl modal-dialog-centered">
    <div class="modal-content" style="height: 90vh;">
      <div class="modal-header">
        <h5 class="modal-title fw-bold" id="viewerTitle">Đang tải...</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body p-0 text-center" style="overflow: hidden; display: flex; align-items: center; justify-content: center; background: #525659;">
        <div id="viewerContainer" style="width:100%; height:100%;"></div>
      </div>
      <div class="modal-footer bg-light">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
        <button type="button" class="btn btn-primary" onclick="printDocument()"><i class="fas fa-print me-2"></i>In tài liệu</button>
      </div>
    </div>
  </div>
</div>

<script>
  let currentFileUrl = '';

  function viewDocument(url, title) {
    currentFileUrl = url;
    document.getElementById('viewerTitle').innerText = title;
    
    const container = document.getElementById('viewerContainer');
    container.innerHTML = ''; // Clear old content
    
    // Check if it's an image or PDF
    const ext = url.split('.').pop().toLowerCase();
    
    if (ext === 'pdf') {
      // Use <object> tag which is less likely to be intercepted by IDM than <iframe>
      container.innerHTML = `<object data="${url}#toolbar=1" type="application/pdf" width="100%" height="100%">
          <p>Trình duyệt của bạn không hỗ trợ xem PDF trực tiếp. <a href="${url}" target="_blank">Nhấn vào đây để tải về</a></p>
        </object>`;
    } else {
      // It's an image
      container.innerHTML = `<img src="${url}" style="max-width:100%; max-height:100%; object-fit:contain; padding:10px;">`;
    }

    var viewerModal = new bootstrap.Modal(document.getElementById('documentViewerModal'));
    viewerModal.show();
  }

  function printDocument() {
    if (!currentFileUrl) return;
    const ext = currentFileUrl.split('.').pop().toLowerCase();
    
    if (ext === 'pdf') {
      const obj = document.querySelector('#viewerContainer object');
      if (obj) {
        try {
          obj.focus();
          obj.print();
        } catch(e) {
          window.open(currentFileUrl).print();
        }
      }
    } else {
      const printWin = window.open('');
      printWin.document.write('<html><body style="margin:0;display:flex;justify-content:center;align-items:center;"><img src="' + currentFileUrl + '" style="max-width:100%;" onload="window.print();window.close();" /></body></html>');
      printWin.document.close();
    }
  }

  document.getElementById('documentViewerModal').addEventListener('hidden.bs.modal', function () {
    document.getElementById('viewerContainer').innerHTML = '';
    currentFileUrl = '';
  });
</script>

<%- include('../partials/footer') %>
