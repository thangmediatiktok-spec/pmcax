<%- include('../partials/header', { activeMenu: 'officers' }) %>
<%- include('../partials/flash') %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h5 class="fw-bold mb-0">Danh sách cán bộ chiến sĩ</h5>
    <small class="text-muted">Tổng: <strong><%= total %></strong> cán bộ</small>
  </div>
  <div class="d-flex gap-2">
    <a href="/officers/export/excel" class="btn btn-primary btn-sm">
      <i class="fas fa-file-export me-1"></i>Xuất Excel
    </a>
    <% if (currentUser && currentUser.role === 'admin') { %>
      <button type="button" class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#importExcelModal">
        <i class="fas fa-file-excel me-1"></i>Nhập Excel
      </button>
      <a href="/officers/create" class="btn btn-danger btn-sm">
        <i class="fas fa-plus me-1"></i>Thêm mới
      </a>
    <% } %>
  </div>
</div>

<!-- Filter -->
<div class="card border-0 shadow-sm mb-3">
  <div class="card-body p-3">
    <form method="GET" action="/officers">
      <div class="row g-2 align-items-end">
        <div class="col-8 col-md-3">
          <label class="form-label small fw-semibold mb-1 d-none d-md-block">Tìm kiếm</label>
          <input type="text" name="search" class="form-control" placeholder="Tên, số hiệu..." value="<%= query.search || '' %>">
        </div>
        <div class="col-4 d-md-none">
          <button class="btn btn-outline-secondary w-100" type="button" data-bs-toggle="collapse" data-bs-target="#advancedFilters">
            <i class="fas fa-filter"></i> Lọc
          </button>
        </div>
        
        <!-- Advanced Filters Collapse -->
        <div class="col-12 col-md-9 collapse d-md-block" id="advancedFilters">
          <div class="row g-2 align-items-end mt-2 mt-md-0">
            <div class="col-6 col-md-3">
              <label class="form-label small fw-semibold mb-1">Chức vụ</label>
              <select name="chucVu" class="form-select">
                <option value="">Tất cả</option>
                <% ['Trưởng Công an xã','Phó Trưởng Công an xã','Cán bộ'].forEach(cv => { %>
                  <option value="<%= cv %>" <%= query.chucVu === cv ? 'selected' : '' %>><%= cv %></option>
                <% }) %>
              </select>
            </div>
            <div class="col-6 col-md-3">
              <label class="form-label small fw-semibold mb-1">Cấp bậc</label>
              <select name="capBac" class="form-select">
                <option value="">Tất cả</option>
                <% ranks.forEach(r => { %>
                  <option value="<%= r %>" <%= query.capBac === r ? 'selected' : '' %>><%= r %></option>
                <% }) %>
              </select>
            </div>
            <div class="col-8 col-md-3">
              <label class="form-label small fw-semibold mb-1">Tổ công tác</label>
              <select name="toCongTac" class="form-select">
                <option value="">Tất cả</option>
                <% teams.forEach(t => { %>
                  <option value="<%= t._id %>" <%= query.toCongTac === t._id.toString() ? 'selected' : '' %>><%= t.ten %></option>
                <% }) %>
              </select>
            </div>
            <div class="col-4 col-md-3 d-flex gap-2">
              <button type="submit" class="btn btn-danger flex-grow-1"><i class="fas fa-search me-1"></i>Lọc</button>
              <a href="/officers" class="btn btn-outline-secondary"><i class="fas fa-times"></i></a>
            </div>
          </div>
        </div>
      </div>
    </form>
  </div>
</div>

<!-- Mobile List View (Only visible on mobile) -->
<div class="d-md-none mb-3">
  <% if (officers.length === 0) { %>
    <div class="text-center py-5 text-muted bg-white rounded shadow-sm">
      <i class="fas fa-search fa-2x mb-2 d-block opacity-25"></i>
      Không tìm thấy cán bộ nào
    </div>
  <% } else { %>
    <div class="list-group shadow-sm border-0">
      <% officers.forEach(o => { %>
        <a href="/officers/<%= o._id %>" class="list-group-item list-group-item-action py-3 border-bottom d-flex align-items-center gap-3">
          <% if (o.anhDaiDien) { %>
            <img src="<%= o.anhDaiDien %>" alt="" style="width:45px;height:45px;border-radius:50%;object-fit:cover">
          <% } else { %>
            <div style="width:45px;height:45px;background:linear-gradient(135deg,#e63946,#c1121f);border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0">
              <span class="text-white fw-bold" style="font-size:16px"><%= o.hoTen.charAt(0) %></span>
            </div>
          <% } %>
          <div class="flex-grow-1">
            <div class="fw-bold mb-1" style="color: #1a2235; font-size: 14px;">
              <%= o.hoTen %> 
            </div>
            <div class="text-muted small mb-1"><i class="fas fa-id-badge me-1"></i><%= o.maSo %> | <%= o.capBac || 'Chưa cấp bậc' %></div>
            <div class="text-muted small"><i class="fas fa-users me-1"></i><%= o.chucVu %> - <%= o.toCongTac ? o.toCongTac.ten : '-' %></div>
          </div>
          <div>
            <i class="fas fa-chevron-right text-muted opacity-50"></i>
          </div>
        </a>
      <% }) %>
    </div>
  <% } %>
</div>

<!-- Desktop Table View (Only visible on desktop) -->
<div class="card border-0 shadow-sm d-none d-md-block">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0 align-middle">
        <thead class="table-light">
          <tr>
            <th class="ps-3" style="width:40px">#</th>
            <th>Cán bộ</th>
            <th>Số hiệu CAND</th>
            <th>Chức vụ</th>
            <th>Cấp bậc</th>
            <th>Điện thoại</th>
            <th>Trạng thái</th>
            <th>Tổ công tác</th>
            <th style="width:100px">Thao tác</th>
          </tr>
        </thead>
        <tbody>
          <% officers.forEach((o, i) => { %>
          <tr onclick="window.location='/officers/<%= o._id %>'" style="cursor: pointer;">
            <td class="ps-3 text-muted small"><%= (page - 1) * 10 + i + 1 %></td>
            <td>
              <div class="d-flex align-items-center gap-2">
                <% if (o.anhDaiDien) { %>
                  <img src="<%= o.anhDaiDien %>" alt="" style="width:36px;height:36px;border-radius:50%;object-fit:cover">
                <% } else { %>
                  <div style="width:36px;height:36px;background:linear-gradient(135deg,#e63946,#c1121f);border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0">
                    <span class="text-white fw-bold" style="font-size:13px"><%= o.hoTen.charAt(0) %></span>
                  </div>
                <% } %>
                <div>
                  <div class="fw-semibold small"><%= o.hoTen %></div>
                  <div class="text-muted" style="font-size:11px"><%= o.gioiTinh %> · <%= o.tuoi ? o.tuoi + ' tuổi' : '' %></div>
                </div>
              </div>
            </td>
            <td><span class="badge bg-light text-dark border"><%= o.maSo %></span></td>
            <td><small><%= o.chucVu %></small></td>
            <td><small><%= o.capBac || '-' %></small></td>
            <td><small><%= o.soDienThoai || '-' %></small></td>
            <td class="text-center" onclick="event.stopPropagation()">
              <% 
                let badgeClass = 'bg-secondary';
                const tt = o.trangThai || 'Đang làm việc';
                if (tt === 'Đang làm việc') badgeClass = 'bg-success';
                else if (tt === 'Nghỉ phép' || tt === 'Nghỉ ốm') badgeClass = 'bg-warning text-dark';
                else if (tt === 'Đi công tác') badgeClass = 'bg-info text-dark';
                else if (tt === 'Vắng không lý do') badgeClass = 'bg-danger';
                else if (tt === 'Đang đi học') badgeClass = 'bg-primary';
              %>
              <% if (currentUser && (currentUser.role === 'admin' || currentUser.role === 'truong_cax' || currentUser.role === 'pho_cax')) { %>
              <select class="form-select form-select-sm quick-status-select"
                      data-id="<%= o._id %>"
                      style="min-width:130px;font-size:11px;padding:2px 6px;border-radius:12px;border:none;background-color:transparent;cursor:pointer;font-weight:600;"
                      title="Nhấp để thay đổi trạng thái">
                <% ['Đang làm việc','Đang đi học','Đi công tác','Nghỉ phép','Nghỉ ốm','Vắng không lý do'].forEach(s => { %>
                  <option value="<%= s %>" <%= s === tt ? 'selected' : '' %>><%= s %></option>
                <% }) %>
              </select>
              <% } else { %>
              <span class="badge <%= badgeClass %>"><%= tt %></span>
              <% } %>
            </td>
            <td>
              <span class="badge bg-primary">
                <%= o.toCongTac ? o.toCongTac.ten : '-' %>
              </span>
            </td>
            <td>
              <div class="d-flex gap-1" onclick="event.stopPropagation()">
                <% 
                  let canEditRow = false, canDeleteRow = false;
                  if (currentUser) {
                    if (currentUser.role === 'admin') { canEditRow = true; canDeleteRow = true; }
                    else if (currentUser.role === 'truong_cax') { canEditRow = true; canDeleteRow = false; }
                    else if (currentUser.role === 'pho_cax') { canEditRow = true; canDeleteRow = false; }
                  }
                %>
                <% if (canEditRow) { %>
                <a href="/officers/<%= o._id %>/edit" class="btn btn-sm btn-outline-warning" title="Sửa"><i class="fas fa-edit"></i></a>
                <% } %>
                <% if (canDeleteRow) { %>
                <form action="/officers/<%= o._id %>?_method=DELETE" method="POST" class="delete-form" data-confirm="Xác nhận xóa cán bộ <%= o.hoTen %>?">
                  <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa"><i class="fas fa-trash"></i></button>
                </form>
                <% } %>
              </div>
            </td>
          </tr>
          <% }) %>
          <% if (officers.length === 0) { %>
          <tr>
            <td colspan="9" class="text-center py-5 text-muted">
              <i class="fas fa-search fa-2x mb-2 d-block opacity-25"></i>
              Không tìm thấy cán bộ nào
            </td>
          </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

  <!-- Pagination -->
  <% if (totalPages > 1) { %>
  <div class="card-footer bg-white border-top py-2">
    <nav>
      <ul class="pagination pagination-sm mb-0 justify-content-center">
        <li class="page-item <%= page <= 1 ? 'disabled' : '' %>">
          <a class="page-link" href="?page=<%= page - 1 %>&<%= new URLSearchParams(query).toString().replace(/&?page=\d+/,'') %>">‹</a>
        </li>
        <% for(let p = 1; p <= totalPages; p++) { %>
        <li class="page-item <%= p === page ? 'active' : '' %>">
          <a class="page-link" href="?page=<%= p %>&<%= new URLSearchParams(query).toString().replace(/&?page=\d+/,'') %>"><%= p %></a>
        </li>
        <% } %>
        <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>">
          <a class="page-link" href="?page=<%= page + 1 %>&<%= new URLSearchParams(query).toString().replace(/&?page=\d+/,'') %>">›</a>
        </li>
      </ul>
    </nav>
  </div>
  <% } %>
</div>

</div>

<!-- Modal Import Excel -->
<div class="modal fade" id="importExcelModal" tabindex="-1" aria-labelledby="importExcelModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form action="/officers/import" method="POST" enctype="multipart/form-data">
        <div class="modal-header">
          <h5 class="modal-title fw-bold" id="importExcelModalLabel"><i class="fas fa-file-excel text-success me-2"></i>Nhập danh sách từ Excel</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <p class="small text-muted mb-2">Vui lòng tải file mẫu và điền dữ liệu theo đúng định dạng trước khi tải lên.</p>
            <a href="/officers/template" class="btn btn-sm btn-outline-primary mb-3">
              <i class="fas fa-download me-1"></i>Tải file Excel mẫu
            </a>
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold small">Chọn file Excel (.xlsx)</label>
            <input type="file" name="file" class="form-control" accept=".xlsx, .xls" required>
          </div>
          <div class="alert alert-warning small py-2 mb-0">
            <i class="fas fa-exclamation-triangle me-1"></i>Hệ thống sẽ tự động bỏ qua các cán bộ có <strong>Số hiệu CAND</strong> đã tồn tại hoặc bị trùng lặp trong file.
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
          <button type="submit" class="btn btn-success"><i class="fas fa-upload me-1"></i>Thực hiện nhập</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
document.querySelectorAll('.quick-status-select').forEach(function(sel) {
  const statusColors = {
    'Đang làm việc': '#198754',
    'Đang đi học': '#0d6efd',
    'Đi công tác': '#0dcaf0',
    'Nghỉ phép': '#ffc107',
    'Nghỉ ốm': '#ffc107',
    'Vắng không lý do': '#dc3545'
  };
  function applyColor(el) {
    const color = statusColors[el.value] || '#6c757d';
    el.style.backgroundColor = color + '22';
    el.style.color = (el.value === 'Nghỉ phép' || el.value === 'Nghỉ ốm' || el.value === 'Đi công tác') ? '#555' : color;
    el.style.borderColor = color + '66';
  }
  applyColor(sel);
  sel.addEventListener('change', async function() {
    const id = this.dataset.id;
    const trangThai = this.value;
    try {
      const res = await fetch('/officers/' + id + '/trangthai', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ trangThai })
      });
      const data = await res.json();
      if (data.success) {
        applyColor(this);
        // Toast thông báo nhỏ
        const toast = document.createElement('div');
        toast.className = 'position-fixed bottom-0 end-0 p-3';
        toast.style.zIndex = 9999;
        toast.innerHTML = `<div class="toast show align-items-center text-white bg-success border-0" role="alert">
          <div class="d-flex"><div class="toast-body"><i class="fas fa-check-circle me-2"></i>Đã cập nhật trạng thái!</div>
          <button type="button" class="btn-close btn-close-white me-2 m-auto" onclick="this.closest('.position-fixed').remove()"></button></div></div>`;
        document.body.appendChild(toast);
        setTimeout(() => toast.remove(), 3000);
      } else {
        alert('Lỗi cập nhật trạng thái!');
        location.reload();
      }
    } catch(e) {
      alert('Lỗi kết nối!');
    }
  });
});
</script>

<%- include('../partials/footer') %>
