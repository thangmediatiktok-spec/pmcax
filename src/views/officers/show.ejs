<%- include('../partials/header', { activeMenu: typeof activeMenu !== 'undefined' ? activeMenu : 'officers' }) %>
<%- include('../partials/flash') %>

<% 
  function fmtDate(d) { return d ? new Date(d).toLocaleDateString('vi-VN') : '-'; }
  const isUnlocked = locals.unlockedProfile;
%>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h5 class="fw-bold mb-0"><i class="fas fa-id-card text-danger me-2"></i>Hồ sơ cán bộ</h5>
  <div class="d-flex gap-2">
    <% if (typeof canEdit !== 'undefined' && canEdit) { %>
    <a href="/officers/<%= officer._id %>/edit" class="btn btn-warning btn-sm"><i class="fas fa-edit me-1"></i>Chỉnh sửa</a>
    <% } %>
    <a href="/officers" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-left me-1"></i>Quay lại</a>
  </div>
</div>

<div class="row g-3">
  <!-- Profile Card -->
  <div class="col-lg-3">
    <div class="card border-0 shadow-sm text-center">
      <div class="card-body p-4">
        <% if (officer.anhDaiDien) { %>
          <img src="<%= officer.anhDaiDien %>" alt="<%= officer.hoTen %>" style="width:120px;height:140px;object-fit:cover;border-radius:8px;margin-bottom:12px">
        <% } else { %>
          <div style="width:100px;height:100px;background:linear-gradient(135deg,#e63946,#c1121f);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 12px">
            <span class="text-white fw-bold" style="font-size:36px"><%= officer.hoTen.charAt(0) %></span>
          </div>
        <% } %>
        <h6 class="fw-bold mb-1"><%= officer.hoTen %></h6>
        <span class="badge bg-secondary mb-2"><%= isUnlocked ? officer.maSo : '***-***' %></span>
        <div class="mb-2">
          <span class="badge bg-primary px-3 py-2">
            <%= officer.toCongTac ? officer.toCongTac.ten : '-' %>
          </span>
        </div>
        <% 
          let badgeClass = 'bg-secondary';
          if (officer.trangThai === 'Đang làm việc') badgeClass = 'bg-success';
          else if (officer.trangThai === 'Nghỉ phép' || officer.trangThai === 'Nghỉ ốm') badgeClass = 'bg-warning text-dark';
          else if (officer.trangThai === 'Đi công tác') badgeClass = 'bg-info text-dark';
          else if (officer.trangThai === 'Vắng không lý do') badgeClass = 'bg-danger';
        %>
        <span class="badge <%= badgeClass %> mb-2"><%= officer.trangThai || 'Đang làm việc' %></span>
        <hr>
        <div class="text-start small">
          <div class="d-flex justify-content-between mb-1">
            <span class="text-muted">Chức vụ</span>
            <span class="fw-semibold text-end" style="max-width:60%"><%= officer.chucVu %></span>
          </div>
          <div class="d-flex justify-content-between mb-1">
            <span class="text-muted">Cấp bậc</span>
            <span class="fw-semibold"><%= officer.capBac || '-' %></span>
          </div>
          <div class="d-flex justify-content-between mb-1">
            <span class="text-muted">Tuổi</span>
            <span class="fw-semibold"><%= isUnlocked ? (officer.tuoi || '-') : '**' %></span>
          </div>
          <div class="d-flex justify-content-between">
            <span class="text-muted">Giới tính</span>
            <span class="fw-semibold"><%= officer.gioiTinh %></span>
          </div>
        </div>
      </div>
    </div>

    <!-- Actions -->
    <% if (typeof canEdit !== 'undefined' && canEdit) { %>
    <div class="card border-0 shadow-sm mt-3">
      <div class="card-body p-3">
        <h6 class="fw-semibold small mb-2">Thao tác</h6>
        <% if (currentUser && currentUser.officerProfile && currentUser.officerProfile.toString() === officer._id.toString()) { %>
        <a href="/officers/export/excel" class="btn btn-outline-success w-100 mb-2 btn-sm">
          <i class="fas fa-file-excel me-1"></i>Xuất Excel hồ sơ
        </a>
        <button class="btn btn-outline-secondary w-100 mb-2 btn-sm" data-bs-toggle="modal" data-bs-target="#changePasswordModal">
          <i class="fas fa-key me-1"></i>Đổi mật khẩu đăng nhập
        </button>
        <% } %>
        <a href="/officers/<%= officer._id %>/edit" class="btn btn-outline-warning w-100 mb-2 btn-sm">
          <i class="fas fa-edit me-1"></i>Chỉnh sửa thông tin
        </a>
        <form action="/officers/<%= officer._id %>?_method=DELETE" method="POST" class="delete-form" data-confirm="Xác nhận xóa cán bộ này?">
          <button type="submit" class="btn btn-outline-danger w-100 btn-sm">
            <i class="fas fa-trash me-1"></i>Xóa hồ sơ
          </button>
        </form>
      </div>
    </div>
    <% } %>

    <div class="card border-0 shadow-sm mt-3">
      <div class="card-body p-3">
        <h6 class="fw-semibold small mb-2">Tài liệu</h6>
        <a href="/officers/<%= officer._id %>/documents" class="btn btn-outline-primary w-100 btn-sm">
          <i class="fas fa-folder-open me-1"></i>Xem Tài liệu đính kèm
        </a>
      </div>
    </div>
  </div>

  <!-- Details -->
  <div class="col-lg-9">
    <div class="card border-0 shadow-sm mb-3">
      <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h6 class="mb-0 fw-semibold"><i class="fas fa-info-circle text-primary me-2"></i>Thông tin cá nhân</h6>
        <% if (!locals.unlockedProfile) { %>
          <button class="btn btn-sm btn-outline-danger fw-bold" data-bs-toggle="modal" data-bs-target="#unlockPinModal">
            <i class="fas fa-eye me-1"></i> Hiển thị toàn bộ
          </button>
        <% } %>
      </div>
      <div class="card-body p-3">
        <div class="row g-2">
          <% 
            const maskPhone = (phone) => phone ? phone.replace(/(\d{3})\d{4}(\d{3})/, '$1****$2') : '-';
            const maskCCCD = (cccd) => cccd ? cccd.replace(/(\d{3})\d{6}(\d{3})/, '$1******$2') : '-';
            const maskText = (text) => text ? '********' : '-';
            const maskDOB = (date) => date ? `**/**/${new Date(date).getFullYear()}` : '-';
            
            const fields = [
            ['Ngày sinh', isUnlocked ? fmtDate(officer.ngaySinh) : maskDOB(officer.ngaySinh)],
            ['Số CCCD', isUnlocked ? officer.soCCCD || '-' : maskCCCD(officer.soCCCD)],
            ['Ngày cấp CCCD', fmtDate(officer.ngayCapCCCD)],
            ['Số điện thoại', isUnlocked ? officer.soDienThoai || '-' : maskPhone(officer.soDienThoai)],
            ['Quê quán', isUnlocked ? officer.queQuan || '-' : maskText(officer.queQuan)],
            ['HKTT', isUnlocked ? officer.diaChiThuongTru || '-' : maskText(officer.diaChiThuongTru)],
            ['Email', officer.email || '-']
          ]; %>
          <% fields.forEach(([label, val]) => { %>
          <div class="col-md-6">
            <div class="d-flex gap-2 py-2 border-bottom">
              <span class="text-muted small" style="min-width:130px"><%= label %></span>
              <span class="fw-medium small"><%= val %></span>
            </div>
          </div>
          <% }) %>
        </div>
      </div>
    </div>

    <div class="card border-0 shadow-sm mb-3">
      <div class="card-header bg-white py-3">
        <h6 class="mb-0 fw-semibold"><i class="fas fa-briefcase text-success me-2"></i>Thông tin công tác</h6>
      </div>
      <div class="card-body p-3">
        <div class="row g-2">
          <% const workFields = [
            ['Số hiệu CAND', isUnlocked ? officer.maSo : '***-***'],
            ['Cấp bậc hàm', officer.capBac || '-'],
            ['Ngày lên hàm gần nhất - Cấp bậc gần nhất', isUnlocked ? fmtDate(officer.ngayNhanCapBac) : '********'],
            ['Chức danh', isUnlocked ? (officer.chucDanh || '-') : '********'],
            ['Chức vụ', officer.chucVu],
            ['Tổ / Đơn vị', officer.toCongTac ? officer.toCongTac.ten : officer.donViCongTac || '-'],
            ['Trạng thái', officer.trangThai || 'Đang làm việc'],
            ['Ngày nhập ngũ', isUnlocked ? fmtDate(officer.ngayNhapNgu) : '********']
          ]; %>
          <% workFields.forEach(([label, val]) => { %>
          <div class="col-md-6">
            <div class="d-flex gap-2 py-2 border-bottom">
              <span class="text-muted small" style="min-width:130px"><%= label %></span>
              <span class="fw-medium small"><%= val %></span>
            </div>
          </div>
          <% }) %>
        </div>
      </div>
    </div>

    <div class="card border-0 shadow-sm mb-3">
      <div class="card-header bg-white py-3">
        <h6 class="mb-0 fw-semibold"><i class="fas fa-history text-secondary me-2"></i>Quá trình công tác</h6>
      </div>
      <div class="card-body p-3">
        <p class="mb-0 small" style="white-space: pre-line"><%= locals.unlockedProfile ? (officer.quaTrinhCongTac || 'Chưa cập nhật') : maskText(officer.quaTrinhCongTac) %></p>
      </div>
    </div>

    <div class="card border-0 shadow-sm mb-3">
      <div class="card-header bg-white py-3">
        <h6 class="mb-0 fw-semibold"><i class="fas fa-graduation-cap text-warning me-2"></i>Trình độ & Bằng cấp</h6>
      </div>
      <div class="card-body p-3">
        <div class="row g-2">
          <% const eduFields = [
            ['Đảng viên', isUnlocked ? (officer.dangVien ? `Đảng viên - ${fmtDate(officer.ngayVaoDang)}` : 'Không') : '********'],
            ['Học vấn', officer.hocVan || '-'],
            ['Nghiệp vụ CA', isUnlocked ? (officer.nghiepVuCA || '-') : '********'],
            ['Trường đào tạo CA', officer.truongDaoTaoCA || '-'],
            ['Chính trị (LLCT)', isUnlocked ? (officer.lyLuanChinhTri || '-') : '********'],
            ['Ngoại ngữ', officer.ngoaiNgu || '-'],
            ['Tin học', officer.tinHoc || '-'],
            ['Chuyên ngành', isUnlocked ? (officer.chuyenNganh || '-') : '********']
          ]; %>
          <% eduFields.forEach(([label, val]) => { %>
          <div class="col-md-4">
            <div class="d-flex flex-column py-2 border-bottom">
              <span class="text-muted small"><%= label %></span>
              <span class="fw-medium"><%= val %></span>
            </div>
          </div>
          <% }) %>
          <% if (officer.ghiChu) { %>
          <div class="col-12 mt-2">
            <span class="text-muted small">Ghi chú</span>
            <p class="mb-0 mt-1"><%= officer.ghiChu %></p>
          </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Watermark chống chụp màn hình -->
<div id="security-watermark" style="
  position: fixed;
  top: 0; left: 0; width: 100vw; height: 100vh;
  pointer-events: none;
  z-index: 9999;
  overflow: hidden;
  display: flex;
  flex-wrap: wrap;
  opacity: 0.05;
  user-select: none;
">
</div>

<script>
  function changeStatus(id, newStatus) {
    if(!confirm(`Xác nhận đổi trạng thái thành: ${newStatus}?`)) return;
    
    fetch(`/officers/${id}/trangthai`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({ trangThai: newStatus })
    })
    .then(res => res.json())
    .then(data => {
      if(data.success) {
        location.reload();
      } else {
        alert('Lỗi: ' + data.message);
      }
    })
    .catch(err => {
      alert('Đã có lỗi xảy ra');
    });
  }

  // Generate Watermark
  const watermarkContainer = document.getElementById('security-watermark');
  const watermarkText = `Tài khoản: <%= locals.currentUser.username %> - IP: <%= locals.clientIp || '127.0.0.1' %> - Ngày: ${new Date().toLocaleDateString('vi-VN')}`;
  
  for(let i = 0; i < 50; i++) {
    const div = document.createElement('div');
    div.textContent = watermarkText;
    div.style.padding = '30px';
    div.style.transform = 'rotate(-30deg)';
    div.style.fontSize = '14px';
    div.style.fontWeight = 'bold';
    div.style.color = '#000';
    div.style.whiteSpace = 'nowrap';
    watermarkContainer.appendChild(div);
  }
</script>

<% if (!locals.unlockedProfile) { %>
<div class="modal fade" id="unlockPinModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow">
      <div class="modal-header bg-danger text-white border-0">
        <h5 class="modal-title fw-bold"><i class="fas fa-lock me-2"></i>Mở khóa Dữ liệu Tối mật</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <form action="/unlock-pin" method="POST">
        <div class="modal-body p-4 text-center">
          <p class="text-muted mb-4">Vui lòng nhập Mã PIN bảo mật cấp 2 để hiển thị toàn bộ thông tin cá nhân của cán bộ.</p>
          <input type="password" name="pinCode" class="form-control form-control-lg text-center fw-bold text-danger mx-auto" maxlength="6" pattern="\d{6}" placeholder="Nhập 6 số Mã PIN" required style="letter-spacing: 15px; font-size: 28px; width: 250px;">
        </div>
        <div class="modal-footer border-0 bg-light">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
          <button type="submit" class="btn btn-danger px-4 fw-bold"><i class="fas fa-unlock me-2"></i>Mở khóa</button>
        </div>
      </form>
    </div>
  </div>
</div>
<% } %>

<%- include('../partials/footer') %>
