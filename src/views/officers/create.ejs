<%- include('../partials/header', { activeMenu: 'officers' }) %>
<%- include('../partials/flash') %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h5 class="fw-bold mb-0"><i class="fas fa-user-plus text-danger me-2"></i>Thêm cán bộ mới</h5>
  <a href="/officers" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-left me-1"></i>Quay lại</a>
</div>

<form action="/officers" method="POST" enctype="multipart/form-data">
  <div class="row g-3">

    <!-- Thông tin cơ bản -->
    <div class="col-lg-8">
      <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-white py-3 border-bottom">
          <h6 class="mb-0 fw-semibold"><i class="fas fa-id-card text-primary me-2"></i>Thông tin cơ bản</h6>
        </div>
        <div class="card-body p-3">
          <div class="row g-3">
            <div class="col-md-4">
              <label class="form-label small fw-semibold">Số hiệu CAND <span class="text-danger">*</span></label>
              <input type="text" name="maSo" class="form-control" required placeholder="xxx-xxx">
            </div>
            <div class="col-md-8">
              <label class="form-label small fw-semibold">Họ và tên <span class="text-danger">*</span></label>
              <input type="text" name="hoTen" class="form-control" required placeholder="Nguyễn Văn A">
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-semibold">Ngày sinh <span class="text-danger">*</span></label>
              <input type="date" name="ngaySinh" class="form-control" required>
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-semibold">Số CCCD</label>
              <input type="text" name="soCCCD" class="form-control" placeholder="0xxxxxxxxxxx">
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-semibold">Ngày cấp CCCD</label>
              <input type="date" name="ngayCapCCCD" class="form-control">
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-semibold">Giới tính <span class="text-danger">*</span></label>
              <select name="gioiTinh" class="form-select" required>
                <option value="Nam">Nam</option>
                <option value="Nữ">Nữ</option>
              </select>
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-semibold">Số điện thoại</label>
              <input type="tel" name="soDienThoai" class="form-control" placeholder="0xxxxxxxxx">
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Quê quán</label>
              <input type="text" name="queQuan" class="form-control" placeholder="Tỉnh/Thành phố">
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Email</label>
              <input type="email" name="email" class="form-control" placeholder="email@example.com">
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Địa chỉ thường trú</label>
              <input type="text" name="diaChiThuongTru" class="form-control">
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-semibold"><i class="fab fa-telegram text-info me-1"></i>Telegram Chat ID</label>
              <input type="text" name="telegramChatId" class="form-control" placeholder="Ví dụ: 123456789">
            </div>
          </div>
        </div>
      </div>

      <!-- Thông tin công tác -->
      <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-white py-3 border-bottom">
          <h6 class="mb-0 fw-semibold"><i class="fas fa-briefcase text-success me-2"></i>Thông tin công tác</h6>
        </div>
        <div class="card-body p-3">
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Chức vụ <span class="text-danger">*</span></label>
              <select name="chucVu" class="form-select" required>
                <option value="">-- Chọn chức vụ --</option>
                <% ['Trưởng Công an xã','Phó Trưởng Công an xã','Cán bộ'].forEach(cv => { %>
                  <option value="<%= cv %>"><%= cv %></option>
                <% }) %>
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Cấp bậc</label>
              <select name="capBac" class="form-select">
                <option value="">-- Chọn cấp bậc --</option>
                <% ranks.forEach(r => { %>
                  <option value="<%= r %>"><%= r %></option>
                <% }) %>
              </select>
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-semibold">Ngày nhập ngũ <span class="text-danger">*</span></label>
              <input type="date" name="ngayNhapNgu" class="form-control" required>
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-semibold">Tổ công tác <span class="text-danger">*</span></label>
              <select name="toCongTac" class="form-select" required>
                <option value="">-- Chọn tổ công tác --</option>
                <% teams.forEach(t => { %>
                  <option value="<%= t._id %>"><%= t.ten %></option>
                <% }) %>
              </select>
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-semibold">Đảng viên</label>
              <select name="dangVien" class="form-select">
                <option value="false">Chưa vào Đảng</option>
                <option value="true">Đảng viên</option>
              </select>
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-semibold">Ngày vào Đảng</label>
              <input type="date" name="ngayVaoDang" class="form-control">
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-semibold">Đơn vị công tác</label>
              <input type="text" name="donViCongTac" class="form-control" value="Công an xã">
            </div>
            <div class="col-md-8">
              <label class="form-label small fw-semibold">Ngày lên hàm gần nhất - Cấp bậc gần nhất</label>
              <input type="date" name="ngayNhanCapBac" class="form-control">
            </div>
          </div>
        </div>
      </div>

      <!-- Trình độ -->
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3 border-bottom">
          <h6 class="mb-0 fw-semibold"><i class="fas fa-graduation-cap text-warning me-2"></i>Trình độ học vấn</h6>
        </div>
        <div class="card-body p-3">
          <div class="row g-3">
            <div class="col-md-4">
              <label class="form-label small fw-semibold">Học vấn</label>
              <select name="hocVan" class="form-select">
                <option value="">-- Chọn --</option>
                <% ['Tiểu học','THCS','THPT','Trung cấp','Cao đẳng','Đại học','Thạc sĩ','Tiến sĩ'].forEach(hv => { %>
                  <option value="<%= hv %>"><%= hv %></option>
                <% }) %>
              </select>
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-semibold">Chuyên ngành</label>
              <input type="text" name="chuyenNganh" class="form-control" placeholder="Luật, An ninh...">
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-semibold">Nghiệp vụ CA</label>
              <input type="text" name="nghiepVuCA" class="form-control" placeholder="Đại học - Luật">
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-semibold">Trường đào tạo CA</label>
              <input type="text" name="truongDaoTaoCA" class="form-control" placeholder="Đại học ANND">
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-semibold">Lý luận chính trị</label>>
              <select name="lyLuanChinhTri" class="form-select">
                <option value="">-- Chọn --</option>
                <% ['Sơ cấp','Trung cấp','Cao cấp','Cử nhân'].forEach(ll => { %>
                  <option value="<%= ll %>"><%= ll %></option>
                <% }) %>
              </select>
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-semibold">Ngoại ngữ</label>
              <input type="text" name="ngoaiNgu" class="form-control" placeholder="VSTEP, IELTS...">
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-semibold">Tin học</label>
              <input type="text" name="tinHoc" class="form-control" placeholder="Tin học ứng dụng B">
            </div>
            <div class="col-12">
              <label class="form-label small fw-semibold">Ghi chú</label>
              <textarea name="ghiChu" class="form-control" rows="2" placeholder="Thông tin bổ sung..."></textarea>
            </div>
          </div>
        </div>
      </div>

      <!-- Quá trình công tác -->
      <div class="card border-0 shadow-sm mt-3">
        <div class="card-header bg-white py-3 border-bottom">
          <h6 class="mb-0 fw-semibold"><i class="fas fa-history text-secondary me-2"></i>Quá trình công tác</h6>
        </div>
        <div class="card-body p-3">
          <textarea name="quaTrinhCongTac" class="form-control" rows="4" placeholder="Chưa cập nhật"></textarea>
        </div>
      </div>
    </div>

    <!-- Ảnh đại diện -->
    <div class="col-lg-4">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3 border-bottom">
          <h6 class="mb-0 fw-semibold"><i class="fas fa-camera text-info me-2"></i>Ảnh đại diện</h6>
        </div>
        <div class="card-body p-3 text-center">
          <div id="previewBox" style="width:140px;height:160px;background:#f8f9fa;border:2px dashed #dee2e6;border-radius:8px;display:flex;align-items:center;justify-content:center;margin:0 auto 12px;overflow:hidden">
            <div id="previewPlaceholder">
              <i class="fas fa-user fa-3x text-muted opacity-25"></i>
              <p class="small text-muted mt-2 mb-0">Chưa chọn ảnh</p>
            </div>
            <img id="previewImg" src="" alt="" style="display:none;width:100%;height:100%;object-fit:cover">
          </div>
          <input type="file" name="anhDaiDien" id="anhInput" accept="image/*" class="form-control form-control-sm" onchange="previewImg(this)">
          <small class="text-muted">JPG, PNG, GIF. Tối đa 2MB</small>
        </div>
      </div>
    </div>

  </div>

  <div class="d-flex gap-2 mt-3">
    <button type="submit" class="btn btn-danger px-4">
      <i class="fas fa-save me-2"></i>Lưu cán bộ
    </button>
    <a href="/officers" class="btn btn-outline-secondary px-4">Hủy</a>
  </div>
</form>

<script>
function previewImg(input) {
  if (input.files && input.files[0]) {
    const reader = new FileReader();
    reader.onload = e => {
      document.getElementById('previewImg').src = e.target.result;
      document.getElementById('previewImg').style.display = 'block';
      document.getElementById('previewPlaceholder').style.display = 'none';
    };
    reader.readAsDataURL(input.files[0]);
  }
}
</script>

<%- include('../partials/footer') %>
