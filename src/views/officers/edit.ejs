<%- include('../partials/header', { activeMenu: typeof activeMenu !== 'undefined' ? activeMenu : 'officers' }) %>
<%- include('../partials/flash') %>

<% function fmtDate(d) { return d ? new Date(d).toISOString().split('T')[0] : ''; } %>
<% const dc = typeof docCounts !== 'undefined' ? docCounts : {}; %>

<style>
.upload-btn {
  border: none;
  background: none;
  padding: 2px 6px;
  border-radius: 4px;
  font-size: 11px;
  cursor: pointer;
  color: #0d6efd;
  transition: all 0.15s;
  display: inline-flex;
  align-items: center;
  gap: 3px;
  vertical-align: middle;
}
.upload-btn:hover { background: #e8f0fe; color: #0b5ed7; }
.upload-badge {
  display: inline-flex;
  align-items: center;
  gap: 3px;
  font-size: 10px;
  background: #198754;
  color: #fff;
  border-radius: 10px;
  padding: 1px 7px;
  vertical-align: middle;
  font-weight: 600;
  cursor: pointer;
}
.upload-badge:hover { background: #157347; }
.field-label-row {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-bottom: 4px;
  flex-wrap: wrap;
}
</style>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h5 class="fw-bold mb-0"><i class="fas fa-user-edit text-warning me-2"></i>Chỉnh sửa: <%= officer.hoTen %></h5>
  <a href="/officers/<%= officer._id %>" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-left me-1"></i>Quay lại</a>
</div>

<form action="/officers/<%= officer._id %>?_method=PUT" method="POST" enctype="multipart/form-data">
  <div class="row g-3">
    <div class="col-lg-8">
      <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-white py-3 border-bottom">
          <h6 class="mb-0 fw-semibold"><i class="fas fa-id-card text-primary me-2"></i>Thông tin cơ bản</h6>
        </div>
        <div class="card-body p-3">
          <div class="row g-3">
            <div class="col-md-4">
              <label class="form-label small fw-semibold">Số hiệu CAND <span class="text-danger">*</span></label>
              <input type="text" name="maSo" class="form-control" required value="<%= officer.maSo %>" <%= (currentUser.role === 'admin' || currentUser.role === 'truong_cax') ? '' : 'disabled' %>>
            </div>
            <div class="col-md-8">
              <label class="form-label small fw-semibold">Họ và tên <span class="text-danger">*</span></label>
              <input type="text" name="hoTen" class="form-control" required value="<%= officer.hoTen %>" <%= (currentUser.role === 'admin' || currentUser.role === 'truong_cax') ? '' : 'disabled' %>>
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-semibold">Ngày sinh <span class="text-danger">*</span></label>
              <input type="date" name="ngaySinh" class="form-control" required value="<%= fmtDate(officer.ngaySinh) %>" <%= (currentUser.role === 'admin' || currentUser.role === 'truong_cax') ? '' : 'disabled' %>>
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-semibold">Số CCCD</label>
              <input type="text" name="soCCCD" class="form-control" value="<%= officer.soCCCD || '' %>">
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-semibold">Ngày cấp CCCD</label>
              <input type="date" name="ngayCapCCCD" class="form-control" value="<%= fmtDate(officer.ngayCapCCCD) %>">
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-semibold">Giới tính</label>
              <select name="gioiTinh" class="form-select" <%= (currentUser.role === 'admin' || currentUser.role === 'truong_cax') ? '' : 'disabled' %>>
                <option value="Nam" <%= officer.gioiTinh === 'Nam' ? 'selected' : '' %>>Nam</option>
                <option value="Nữ" <%= officer.gioiTinh === 'Nữ' ? 'selected' : '' %>>Nữ</option>
              </select>
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-semibold">Số điện thoại</label>
              <input type="tel" name="soDienThoai" class="form-control" value="<%= officer.soDienThoai || '' %>">
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Quê quán</label>
              <input type="text" name="queQuan" class="form-control" value="<%= officer.queQuan || '' %>">
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Email</label>
              <input type="email" name="email" class="form-control" value="<%= officer.email || '' %>">
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Địa chỉ thường trú</label>
              <input type="text" name="diaChiThuongTru" class="form-control" value="<%= officer.diaChiThuongTru || '' %>">
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-semibold"><i class="fab fa-telegram text-info me-1"></i>Telegram Chat ID</label>
              <input type="text" name="telegramChatId" class="form-control" value="<%= officer.telegramChatId || '' %>" placeholder="Ví dụ: 123456789">
            </div>
          </div>
        </div>
      </div>

      <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-white py-3 border-bottom">
          <h6 class="mb-0 fw-semibold"><i class="fas fa-briefcase text-success me-2"></i>Thông tin công tác</h6>
        </div>
        <div class="card-body p-3">
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Chức vụ <span class="text-danger">*</span></label>
              <select name="chucVu" class="form-select" <%= (currentUser.role === 'admin' || currentUser.role === 'truong_cax') ? 'required' : 'disabled' %>>
                <% ['Trưởng Công an xã','Phó Trưởng Công an xã','Cán bộ'].forEach(cv => { %>
                  <option value="<%= cv %>" <%= officer.chucVu === cv ? 'selected' : '' %>><%= cv %></option>
                <% }) %>
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Cấp bậc</label>
              <select name="capBac" class="form-select">
                <option value="">-- Chọn cấp bậc --</option>
                <% ranks.forEach(r => { %>
                  <option value="<%= r %>" <%= officer.capBac === r ? 'selected' : '' %>><%= r %></option>
                <% }) %>
              </select>
            </div>

            <%# Ngày nhập ngũ - CÓ NÚT UPLOAD %>
            <div class="col-md-4">
              <div class="field-label-row">
                <span class="form-label small fw-semibold mb-0">Ngày nhập ngũ <span class="text-danger">*</span></span>
                <% if (dc['ngayNhapNgu'] && dc['ngayNhapNgu'] > 0) { %>
                  <span class="upload-badge" onclick="openQuickUpload('ngayNhapNgu','Quyết định tuyển dụng / nhập ngũ','Quyết định')" title="Xem/thêm tài liệu">
                    <i class="fas fa-paperclip"></i><%= dc['ngayNhapNgu'] %> tài liệu
                  </span>
                <% } else { %>
                  <button type="button" class="upload-btn" onclick="openQuickUpload('ngayNhapNgu','Quyết định tuyển dụng / nhập ngũ','Quyết định')" title="Đính kèm tài liệu">
                    <i class="fas fa-paperclip"></i>Đính kèm
                  </button>
                <% } %>
              </div>
              <input type="date" name="ngayNhapNgu" class="form-control" value="<%= fmtDate(officer.ngayNhapNgu) %>" <%= (currentUser.role === 'admin' || currentUser.role === 'truong_cax') ? 'required' : 'disabled' %>>
            </div>

            <div class="col-md-4">
              <label class="form-label small fw-semibold">Tổ công tác <span class="text-danger">*</span></label>
              <select name="toCongTac" class="form-select" <%= (currentUser.role === 'admin' || currentUser.role === 'truong_cax') ? 'required' : 'disabled' %>>
                <% teams.forEach(t => { %>
                  <option value="<%= t._id %>" <%= officer.toCongTac && officer.toCongTac._id.toString() === t._id.toString() ? 'selected' : '' %>><%= t.ten %></option>
                <% }) %>
              </select>
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-semibold">Trạng thái <span class="text-danger">*</span></label>
              <select name="trangThai" class="form-select" required>
                <% ['Đang làm việc', 'Đang đi học', 'Đi công tác', 'Nghỉ phép', 'Nghỉ ốm', 'Vắng không lý do'].forEach(tt => { %>
                  <option value="<%= tt %>" <%= (officer.trangThai || 'Đang làm việc') === tt ? 'selected' : '' %>><%= tt %></option>
                <% }) %>
              </select>
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-semibold">Đơn vị công tác</label>
              <input type="text" name="donViCongTac" class="form-control" value="<%= officer.donViCongTac || '' %>">
            </div>

            <%# Ngày lên hàm - CÓ NÚT UPLOAD %>
            <div class="col-md-8">
              <div class="field-label-row">
                <span class="form-label small fw-semibold mb-0">Ngày lên hàm gần nhất - Cấp bậc gần nhất</span>
                <% if (dc['ngayNhanCapBac'] && dc['ngayNhanCapBac'] > 0) { %>
                  <span class="upload-badge" onclick="openQuickUpload('ngayNhanCapBac','Quyết định thăng cấp bậc hàm','Quyết định')" title="Xem/thêm tài liệu">
                    <i class="fas fa-paperclip"></i><%= dc['ngayNhanCapBac'] %> tài liệu
                  </span>
                <% } else { %>
                  <button type="button" class="upload-btn" onclick="openQuickUpload('ngayNhanCapBac','Quyết định thăng cấp bậc hàm','Quyết định')" title="Đính kèm tài liệu">
                    <i class="fas fa-paperclip"></i>Đính kèm
                  </button>
                <% } %>
              </div>
              <input type="date" name="ngayNhanCapBac" class="form-control" value="<%= fmtDate(officer.ngayNhanCapBac) %>">
            </div>

            <%# Chức danh - CÓ NÚT UPLOAD %>
            <div class="col-md-4">
              <div class="field-label-row">
                <span class="form-label small fw-semibold mb-0">Chức danh</span>
                <% if (dc['chucDanh'] && dc['chucDanh'] > 0) { %>
                  <span class="upload-badge" onclick="openQuickUpload('chucDanh','Quyết định bổ nhiệm chức danh','Quyết định')" title="Xem/thêm tài liệu">
                    <i class="fas fa-paperclip"></i><%= dc['chucDanh'] %> tài liệu
                  </span>
                <% } else { %>
                  <button type="button" class="upload-btn" onclick="openQuickUpload('chucDanh','Quyết định bổ nhiệm chức danh','Quyết định')" title="Đính kèm tài liệu">
                    <i class="fas fa-paperclip"></i>Đính kèm
                  </button>
                <% } %>
              </div>
              <input type="text" name="chucDanh" class="form-control" value="<%= officer.chucDanh || '' %>">
            </div>
          </div>
        </div>
      </div>

      <!-- Trình độ học vấn -->
      <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-white py-3 border-bottom">
          <h6 class="mb-0 fw-semibold"><i class="fas fa-graduation-cap text-warning me-2"></i>Trình độ học vấn &amp; Đảng</h6>
        </div>
        <div class="card-body p-3">
          <div class="row g-3">

            <%# Đảng viên - CÓ NÚT UPLOAD %>
            <div class="col-md-4">
              <div class="field-label-row">
                <span class="form-label small fw-semibold mb-0">Đảng viên</span>
                <% if (dc['dangVien'] && dc['dangVien'] > 0) { %>
                  <span class="upload-badge" onclick="openQuickUpload('dangVien','Hồ sơ Đảng viên','Hồ sơ lý lịch')" title="Xem/thêm tài liệu">
                    <i class="fas fa-paperclip"></i><%= dc['dangVien'] %> tài liệu
                  </span>
                <% } else { %>
                  <button type="button" class="upload-btn" onclick="openQuickUpload('dangVien','Hồ sơ Đảng viên','Hồ sơ lý lịch')" title="Đính kèm tài liệu">
                    <i class="fas fa-paperclip"></i>Đính kèm
                  </button>
                <% } %>
              </div>
              <select name="dangVien" class="form-select">
                <option value="false" <%= !officer.dangVien ? 'selected' : '' %>>Chưa vào Đảng</option>
                <option value="true" <%= officer.dangVien ? 'selected' : '' %>>Đảng viên</option>
              </select>
            </div>

            <div class="col-md-4">
              <label class="form-label small fw-semibold">Ngày vào Đảng</label>
              <input type="date" name="ngayVaoDang" class="form-control" value="<%= fmtDate(officer.ngayVaoDang) %>">
            </div>

            <%# Học vấn - CÓ NÚT UPLOAD %>
            <div class="col-md-4">
              <div class="field-label-row">
                <span class="form-label small fw-semibold mb-0">Học vấn</span>
                <% if (dc['hocVan'] && dc['hocVan'] > 0) { %>
                  <span class="upload-badge" onclick="openQuickUpload('hocVan','Bằng tốt nghiệp','Bằng cấp/Chứng chỉ')" title="Xem/thêm tài liệu">
                    <i class="fas fa-paperclip"></i><%= dc['hocVan'] %> tài liệu
                  </span>
                <% } else { %>
                  <button type="button" class="upload-btn" onclick="openQuickUpload('hocVan','Bằng tốt nghiệp','Bằng cấp/Chứng chỉ')" title="Đính kèm tài liệu">
                    <i class="fas fa-paperclip"></i>Đính kèm
                  </button>
                <% } %>
              </div>
              <select name="hocVan" class="form-select">
                <option value="">-- Chọn --</option>
                <% ['Tiểu học','THCS','THPT','Trung cấp','Cao đẳng','Đại học','Thạc sĩ','Tiến sĩ'].forEach(hv => { %>
                  <option value="<%= hv %>" <%= officer.hocVan === hv ? 'selected' : '' %>><%= hv %></option>
                <% }) %>
              </select>
            </div>

            <div class="col-md-4">
              <label class="form-label small fw-semibold">Chuyên ngành</label>
              <input type="text" name="chuyenNganh" class="form-control" value="<%= officer.chuyenNganh || '' %>">
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-semibold">Nghiệp vụ CA</label>
              <input type="text" name="nghiepVuCA" class="form-control" value="<%= officer.nghiepVuCA || '' %>">
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-semibold">Trường đào tạo CA</label>
              <input type="text" name="truongDaoTaoCA" class="form-control" value="<%= officer.truongDaoTaoCA || '' %>">
            </div>

            <%# Lý luận chính trị - CÓ NÚT UPLOAD %>
            <div class="col-md-4">
              <div class="field-label-row">
                <span class="form-label small fw-semibold mb-0">Lý luận chính trị</span>
                <% if (dc['lyLuanChinhTri'] && dc['lyLuanChinhTri'] > 0) { %>
                  <span class="upload-badge" onclick="openQuickUpload('lyLuanChinhTri','Chứng chỉ Lý luận chính trị','Bằng cấp/Chứng chỉ')" title="Xem/thêm tài liệu">
                    <i class="fas fa-paperclip"></i><%= dc['lyLuanChinhTri'] %> tài liệu
                  </span>
                <% } else { %>
                  <button type="button" class="upload-btn" onclick="openQuickUpload('lyLuanChinhTri','Chứng chỉ Lý luận chính trị','Bằng cấp/Chứng chỉ')" title="Đính kèm tài liệu">
                    <i class="fas fa-paperclip"></i>Đính kèm
                  </button>
                <% } %>
              </div>
              <select name="lyLuanChinhTri" class="form-select">
                <option value="">-- Chọn --</option>
                <% ['Sơ cấp','Trung cấp','Cao cấp','Cử nhân'].forEach(ll => { %>
                  <option value="<%= ll %>" <%= officer.lyLuanChinhTri === ll ? 'selected' : '' %>><%= ll %></option>
                <% }) %>
              </select>
            </div>

            <%# Ngoại ngữ - CÓ NÚT UPLOAD %>
            <div class="col-md-4">
              <div class="field-label-row">
                <span class="form-label small fw-semibold mb-0">Ngoại ngữ</span>
                <% if (dc['ngoaiNgu'] && dc['ngoaiNgu'] > 0) { %>
                  <span class="upload-badge" onclick="openQuickUpload('ngoaiNgu','Chứng chỉ Ngoại ngữ','Bằng cấp/Chứng chỉ')" title="Xem/thêm tài liệu">
                    <i class="fas fa-paperclip"></i><%= dc['ngoaiNgu'] %> tài liệu
                  </span>
                <% } else { %>
                  <button type="button" class="upload-btn" onclick="openQuickUpload('ngoaiNgu','Chứng chỉ Ngoại ngữ','Bằng cấp/Chứng chỉ')" title="Đính kèm tài liệu">
                    <i class="fas fa-paperclip"></i>Đính kèm
                  </button>
                <% } %>
              </div>
              <input type="text" name="ngoaiNgu" class="form-control" value="<%= officer.ngoaiNgu || '' %>">
            </div>

            <%# Tin học - CÓ NÚT UPLOAD %>
            <div class="col-md-4">
              <div class="field-label-row">
                <span class="form-label small fw-semibold mb-0">Tin học</span>
                <% if (dc['tinHoc'] && dc['tinHoc'] > 0) { %>
                  <span class="upload-badge" onclick="openQuickUpload('tinHoc','Chứng chỉ Tin học','Bằng cấp/Chứng chỉ')" title="Xem/thêm tài liệu">
                    <i class="fas fa-paperclip"></i><%= dc['tinHoc'] %> tài liệu
                  </span>
                <% } else { %>
                  <button type="button" class="upload-btn" onclick="openQuickUpload('tinHoc','Chứng chỉ Tin học','Bằng cấp/Chứng chỉ')" title="Đính kèm tài liệu">
                    <i class="fas fa-paperclip"></i>Đính kèm
                  </button>
                <% } %>
              </div>
              <input type="text" name="tinHoc" class="form-control" value="<%= officer.tinHoc || '' %>">
            </div>

            <div class="col-12">
              <label class="form-label small fw-semibold">Ghi chú</label>
              <textarea name="ghiChu" class="form-control" rows="2"><%= officer.ghiChu || '' %></textarea>
            </div>
          </div>
        </div>
      </div>

      <!-- Quá trình công tác -->
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3 border-bottom">
          <h6 class="mb-0 fw-semibold"><i class="fas fa-history text-secondary me-2"></i>Quá trình công tác</h6>
        </div>
        <div class="card-body p-3">
          <textarea name="quaTrinhCongTac" class="form-control" rows="4"><%= officer.quaTrinhCongTac || '' %></textarea>
        </div>
      </div>
    </div>

    <div class="col-lg-4">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3 border-bottom">
          <h6 class="mb-0 fw-semibold"><i class="fas fa-camera text-info me-2"></i>Ảnh đại diện</h6>
        </div>
        <div class="card-body p-3 text-center">
          <div style="width:140px;height:160px;border-radius:8px;overflow:hidden;margin:0 auto 12px;background:#f8f9fa;border:2px dashed #dee2e6">
            <% if (officer.anhDaiDien) { %>
              <img id="previewImg" src="<%= officer.anhDaiDien %>" alt="" style="width:100%;height:100%;object-fit:cover">
            <% } else { %>
              <img id="previewImg" src="" alt="" style="display:none;width:100%;height:100%;object-fit:cover">
              <div id="previewPlaceholder" style="height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center">
                <i class="fas fa-user fa-3x text-muted opacity-25"></i>
                <p class="small text-muted mt-2 mb-0">Chưa có ảnh</p>
              </div>
            <% } %>
          </div>
          <input type="file" name="anhDaiDien" accept="image/*" class="form-control form-control-sm" onchange="previewImg(this)">
          <small class="text-muted">Để trống nếu không thay đổi ảnh</small>
        </div>
      </div>

      <!-- Hướng dẫn upload nhanh -->
      <div class="card border-0 shadow-sm mt-3 border-primary border-opacity-25">
        <div class="card-body p-3">
          <h6 class="fw-semibold small mb-2 text-primary"><i class="fas fa-paperclip me-1"></i>Upload tài liệu nhanh</h6>
          <p class="small text-muted mb-2">Nhấn nút <strong class="text-primary">Đính kèm</strong> bên cạnh từng trường để upload minh chứng tài liệu trực tiếp. Tài liệu sẽ tự đồng bộ vào mục Hồ sơ điện tử.</p>
          <a href="/officers/<%= officer._id %>/documents" class="btn btn-outline-primary btn-sm w-100" target="_blank">
            <i class="fas fa-folder-open me-1"></i>Xem toàn bộ tài liệu
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="d-flex gap-2 mt-3">
    <button type="submit" class="btn btn-warning px-4 fw-semibold"><i class="fas fa-save me-2"></i>Lưu thay đổi</button>
    <a href="/officers/<%= officer._id %>" class="btn btn-outline-secondary px-4">Hủy</a>
  </div>
</form>

<!-- Modal Upload Nhanh (dùng chung cho tất cả các trường) -->
<div class="modal fade" id="quickUploadModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow">
      <div class="modal-header bg-primary text-white border-0">
        <h5 class="modal-title fw-bold fs-6"><i class="fas fa-paperclip me-2"></i><span id="quickUploadTitle">Đính kèm tài liệu</span></h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body p-4">
        <input type="hidden" id="qu_nguonTruong">
        <div class="mb-3">
          <label class="form-label fw-semibold small">Tên tài liệu <span class="text-danger">*</span></label>
          <input type="text" id="qu_tenTaiLieu" class="form-control" placeholder="VD: Quyết định thăng cấp bậc hàm Đại úy">
        </div>
        <div class="mb-3">
          <label class="form-label fw-semibold small">Loại tài liệu <span class="text-danger">*</span></label>
          <select id="qu_loaiTaiLieu" class="form-select">
            <option value="Quyết định">Quyết định</option>
            <option value="Bằng cấp/Chứng chỉ">Bằng cấp/Chứng chỉ</option>
            <option value="Căn cước công dân">Căn cước công dân</option>
            <option value="Hồ sơ lý lịch">Hồ sơ lý lịch</option>
            <option value="Khác">Khác</option>
          </select>
        </div>
        <div class="mb-3">
          <label class="form-label fw-semibold small">Ngày cấp (không bắt buộc)</label>
          <input type="date" id="qu_ngayCap" class="form-control">
        </div>
        <div class="mb-3">
          <label class="form-label fw-semibold small">Chọn file <span class="text-danger">*</span></label>
          <input type="file" id="qu_files" class="form-control" multiple accept=".pdf,.jpg,.jpeg,.png">
          <div class="form-text">Hỗ trợ nhiều file (PDF, JPG, PNG). Tối đa 5MB mỗi file.</div>
        </div>
        <!-- Progress -->
        <div id="qu_progress" class="d-none">
          <div class="progress mb-2" style="height:6px">
            <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary w-100"></div>
          </div>
          <p class="small text-muted text-center mb-0">Đang tải lên...</p>
        </div>
        <!-- Kết quả -->
        <div id="qu_result" class="d-none"></div>
      </div>
      <div class="modal-footer border-0 bg-light">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
        <button type="button" class="btn btn-primary px-4 fw-bold" id="qu_submitBtn" onclick="doQuickUpload()">
          <i class="fas fa-upload me-2"></i>Tải lên
        </button>
      </div>
    </div>
  </div>
</div>

<script>
function previewImg(input) {
  if (input.files && input.files[0]) {
    const reader = new FileReader();
    reader.onload = e => {
      const img = document.getElementById('previewImg');
      img.src = e.target.result;
      img.style.display = 'block';
      const ph = document.getElementById('previewPlaceholder');
      if (ph) ph.style.display = 'none';
    };
    reader.readAsDataURL(input.files[0]);
  }
}

const OFFICER_ID = '<%= officer._id %>';

function openQuickUpload(nguonTruong, defaultTitle, defaultLoai) {
  // Reset form
  document.getElementById('qu_nguonTruong').value = nguonTruong;
  document.getElementById('qu_tenTaiLieu').value = defaultTitle;
  document.getElementById('qu_ngayCap').value = '';
  document.getElementById('qu_files').value = '';
  document.getElementById('qu_progress').classList.add('d-none');
  document.getElementById('qu_result').classList.add('d-none');
  document.getElementById('qu_submitBtn').disabled = false;

  // Set loai
  const loaiSelect = document.getElementById('qu_loaiTaiLieu');
  for (let i = 0; i < loaiSelect.options.length; i++) {
    if (loaiSelect.options[i].value === defaultLoai) {
      loaiSelect.selectedIndex = i;
      break;
    }
  }

  // Update modal title
  const labelMap = {
    'ngayNhanCapBac': 'Ngày lên hàm - Cấp bậc gần nhất',
    'ngayNhapNgu': 'Ngày nhập ngũ',
    'dangVien': 'Đảng viên',
    'hocVan': 'Học vấn',
    'lyLuanChinhTri': 'Chính trị (LLCT)',
    'tinHoc': 'Tin học',
    'ngoaiNgu': 'Ngoại ngữ',
    'chucDanh': 'Chức danh'
  };
  document.getElementById('quickUploadTitle').textContent = 'Đính kèm: ' + (labelMap[nguonTruong] || nguonTruong);

  new bootstrap.Modal(document.getElementById('quickUploadModal')).show();
}

async function doQuickUpload() {
  const nguonTruong = document.getElementById('qu_nguonTruong').value;
  const tenTaiLieu = document.getElementById('qu_tenTaiLieu').value.trim();
  const loaiTaiLieu = document.getElementById('qu_loaiTaiLieu').value;
  const ngayCap = document.getElementById('qu_ngayCap').value;
  const filesInput = document.getElementById('qu_files');

  if (!tenTaiLieu) {
    alert('Vui lòng nhập tên tài liệu.');
    return;
  }
  if (!filesInput.files || filesInput.files.length === 0) {
    alert('Vui lòng chọn ít nhất 1 file.');
    return;
  }

  // Show progress
  document.getElementById('qu_progress').classList.remove('d-none');
  document.getElementById('qu_result').classList.add('d-none');
  document.getElementById('qu_submitBtn').disabled = true;

  const formData = new FormData();
  formData.append('officer', OFFICER_ID);
  formData.append('tenTaiLieu', tenTaiLieu);
  formData.append('loaiTaiLieu', loaiTaiLieu);
  formData.append('nguonTruong', nguonTruong);
  if (ngayCap) formData.append('ngayCap', ngayCap);
  for (const file of filesInput.files) {
    formData.append('files', file);
  }

  try {
    const res = await fetch('/documents/quick-upload', {
      method: 'POST',
      body: formData
    });
    const data = await res.json();

    document.getElementById('qu_progress').classList.add('d-none');
    const resultEl = document.getElementById('qu_result');
    resultEl.classList.remove('d-none');

    if (data.success) {
      resultEl.innerHTML = `<div class="alert alert-success py-2 mb-0"><i class="fas fa-check-circle me-1"></i>${data.message} (${data.fileCount} file). Tổng: <strong>${data.totalCount} tài liệu</strong> cho mục này.</div>`;
      // Cập nhật badge trên form không cần reload
      updateBadge(nguonTruong, data.totalCount);
      // Reset file input
      filesInput.value = '';
      document.getElementById('qu_submitBtn').disabled = false;
    } else {
      resultEl.innerHTML = `<div class="alert alert-danger py-2 mb-0"><i class="fas fa-times-circle me-1"></i>${data.message || 'Lỗi không xác định.'}</div>`;
      document.getElementById('qu_submitBtn').disabled = false;
    }
  } catch (err) {
    document.getElementById('qu_progress').classList.add('d-none');
    const resultEl = document.getElementById('qu_result');
    resultEl.classList.remove('d-none');
    resultEl.innerHTML = `<div class="alert alert-danger py-2 mb-0"><i class="fas fa-times-circle me-1"></i>Lỗi kết nối server.</div>`;
    document.getElementById('qu_submitBtn').disabled = false;
  }
}

function updateBadge(nguonTruong, count) {
  // Tìm tất cả nút upload/badge có liên quan đến nguonTruong này và cập nhật
  // Dùng onclick attribute để match
  const allBtns = document.querySelectorAll(`[onclick*="'${nguonTruong}'"]`);
  allBtns.forEach(btn => {
    const labelMap = {
      'ngayNhanCapBac': 'Quyết định thăng cấp bậc hàm',
      'ngayNhapNgu': 'Quyết định tuyển dụng / nhập ngũ',
      'dangVien': 'Hồ sơ Đảng viên',
      'hocVan': 'Bằng tốt nghiệp',
      'lyLuanChinhTri': 'Chứng chỉ Lý luận chính trị',
      'tinHoc': 'Chứng chỉ Tin học',
      'ngoaiNgu': 'Chứng chỉ Ngoại ngữ',
      'chucDanh': 'Quyết định bổ nhiệm chức danh'
    };
    const loaiMap = {
      'ngayNhanCapBac': 'Quyết định',
      'ngayNhapNgu': 'Quyết định',
      'dangVien': 'Hồ sơ lý lịch',
      'hocVan': 'Bằng cấp/Chứng chỉ',
      'lyLuanChinhTri': 'Bằng cấp/Chứng chỉ',
      'tinHoc': 'Bằng cấp/Chứng chỉ',
      'ngoaiNgu': 'Bằng cấp/Chứng chỉ',
      'chucDanh': 'Quyết định'
    };
    const title = labelMap[nguonTruong] || '';
    const loai = loaiMap[nguonTruong] || 'Khác';
    const onclickVal = `openQuickUpload('${nguonTruong}','${title}','${loai}')`;
    btn.setAttribute('onclick', onclickVal);
    btn.className = 'upload-badge';
    btn.title = 'Xem/thêm tài liệu';
    btn.innerHTML = `<i class="fas fa-paperclip"></i>${count} tài liệu`;
  });
}
</script>

