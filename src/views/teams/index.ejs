<%- include('../partials/header', { activeMenu: 'teams' }) %>
<%- include('../partials/flash') %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h5 class="fw-bold mb-0"><i class="fas fa-people-group text-danger me-2"></i>Quản lý tổ công tác</h5>
    <small class="text-muted">Danh mục tổ công tác sử dụng trong hồ sơ cán bộ</small>
  </div>
  <% if (currentUser && currentUser.role === 'admin') { %>
  <a href="/teams/create" class="btn btn-danger btn-sm"><i class="fas fa-plus me-1"></i>Thêm tổ công tác</a>
  <% } %>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0 align-middle">
        <thead class="table-light">
          <tr>
            <th class="ps-3">#</th>
            <th>Tên tổ công tác</th>
            <th>Thứ tự</th>
            <th>Mô tả</th>
            <th>Trạng thái</th>
            <th>Số cán bộ</th>
            <% if (currentUser && currentUser.role === 'admin') { %><th>Thao tác</th><% } %>
          </tr>
        </thead>
        <tbody>
          <% teams.forEach((team, i) => { %>
          <tr>
            <td class="ps-3 text-muted small"><%= i + 1 %></td>
            <td class="fw-semibold"><%= team.ten %></td>
            <td><span class="badge bg-light text-dark border"><%= team.thuTu %></span></td>
            <td><small class="text-muted"><%= team.moTa || '-' %></small></td>
            <td><span class="badge bg-<%= team.trangThai ? 'success' : 'secondary' %>"><%= team.trangThai ? 'Đang sử dụng' : 'Đã ẩn' %></span></td>
            <td><span class="text-muted small">Đang xem theo hồ sơ</span></td>
            <% if (currentUser && currentUser.role === 'admin') { %>
            <td>
              <div class="d-flex gap-1">
                <a href="/teams/<%= team._id %>/edit" class="btn btn-sm btn-outline-warning"><i class="fas fa-edit"></i></a>
                <form action="/teams/<%= team._id %>?_method=DELETE" method="POST" class="delete-form" data-confirm="Xóa tổ công tác <%= team.ten %>?">
                  <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
                </form>
              </div>
            </td>
            <% } %>
          </tr>
          <% }) %>
          <% if (teams.length === 0) { %>
          <tr><td colspan="7" class="text-center py-5 text-muted">Chưa có tổ công tác nào</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
