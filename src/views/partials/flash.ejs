<% if (success && success.length > 0) { %>
  <script>
    document.addEventListener("DOMContentLoaded", function() {
      toastr.success("<%= success[0] %>");
    });
  </script>
<% } %>
<% if (error && error.length > 0) { %>
  <script>
    document.addEventListener("DOMContentLoaded", function() {
      toastr.error("<%= error[0] %>");
    });
  </script>
<% } %>
