<%- include('../partials/header', { activeMenu: 'leaves_taken' }) %>
<%- include('../partials/flash') %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h4 class="fw-bold mb-0 text-success"><i class="fas fa-user-check me-2"></i>Cán bộ đã sử dụng phép</h4>
    <small class="text-muted">Năm <%= year %></small>
  </div>
  <form method="GET" action="/leaves/taken" class="d-flex align-items-center">
    <label class="me-2 fw-semibold small">Năm:</label>
    <select name="year" class="form-select form-select-sm border-success text-success fw-bold" style="width: 100px;" onchange="this.form.submit()">
      <% const currentY = new Date().getFullYear(); %>
      <% for(let y = currentY + 1; y >= currentY - 5; y--) { %>
        <option value="<%= y %>" <%= year === y ? 'selected' : '' %>><%= y %></option>
      <% } %>
    </select>
  </form>
</div>

<div class="card border-0 shadow-sm mb-4">
  <div class="card-body p-0">
    <% const fmtDate = d => d ? new Date(d).toLocaleDateString('vi-VN') : '-'; %>
    <%- include('./_balanceTable', { list: daNghi, year: year, fmtDate: fmtDate }) %>
  </div>
</div>

<%- include('../partials/footer') %>
