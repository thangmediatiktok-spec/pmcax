<%- include('../partials/header', { activeMenu: 'leaves_requests' }) %>
<%- include('../partials/flash') %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h4 class="fw-bold mb-0 text-primary"><i class="fas fa-list-ul me-2"></i>Danh sách đơn nghỉ phép</h4>
    <small class="text-muted">Tổng quan năm <%= year %></small>
  </div>
  <div class="d-flex align-items-center gap-3">
    <a href="/leaves/print-form" class="btn btn-sm btn-danger fw-bold shadow-sm">
      <i class="fas fa-file-pdf me-1"></i> Xuất đơn PDF
    </a>
    <form method="GET" action="/leaves" class="d-flex align-items-center">
      <label class="me-2 fw-semibold small">Năm:</label>
      <select name="year" class="form-select form-select-sm border-primary text-primary fw-bold" style="width: 100px;" onchange="this.form.submit()">
        <% const currentY = new Date().getFullYear(); %>
        <% for(let y = currentY + 1; y >= currentY - 5; y--) { %>
          <option value="<%= y %>" <%= year === y ? 'selected' : '' %>><%= y %></option>
        <% } %>
      </select>
    </form>
  </div>
</div>

<!-- Summary Cards -->
<div class="row g-3 mb-4">

  <div class="col-md-3">
    <div class="card border-0 shadow-sm bg-success text-white h-100">
      <div class="card-body">
        <h6 class="card-title text-white-50 mb-1"><i class="fas fa-user-check me-1"></i>Đang nghỉ phép</h6>
        <h3 class="fw-bold mb-0"><%= currentlyOnLeave.length %> <small class="fs-6 fw-normal">cán bộ</small></h3>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card border-0 shadow-sm bg-info text-white h-100">
      <div class="card-body">
        <h6 class="card-title text-white-50 mb-1"><i class="fas fa-calendar-alt me-1"></i>Tổng lượt xin nghỉ (Năm)</h6>
        <h3 class="fw-bold mb-0"><%= allLeaves.length %> <small class="fs-6 fw-normal">lượt</small></h3>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card border-0 shadow-sm bg-secondary text-white h-100">
      <div class="card-body">
        <h6 class="card-title text-white-50 mb-1"><i class="fas fa-users me-1"></i>Đã sử dụng phép năm</h6>
        <h3 class="fw-bold mb-0"><%= daNghiLength %> <small class="fs-6 fw-normal">cán bộ</small></h3>
      </div>
    </div>
  </div>
</div>

<div class="card border-0 shadow-sm mb-4">
  <div class="card-header bg-white pt-3 pb-2 border-bottom-0">
    <h6 class="mb-0 fw-semibold text-primary"><i class="fas fa-list-ul me-2"></i>Chi tiết tất cả đơn xin nghỉ</h6>
  </div>
  <div class="card-body p-0">
    <!-- Mobile List View -->
    <div class="d-md-none">
      <% const fmtDateMobile = d => d ? new Date(d).toLocaleDateString('vi-VN') : '-'; %>
      <% if (allLeaves.length === 0) { %>
        <div class="text-center text-muted py-4">Chưa có đơn xin nghỉ phép nào</div>
      <% } else { %>
        <div class="list-group list-group-flush">
          <% allLeaves.forEach(l => { %>
            <% 
              let bClass = 'bg-warning text-dark';
              let status = l.trangThai || 'Đã duyệt';
              if(status === 'Đã duyệt') bClass = 'bg-success';
              if(status === 'Từ chối') bClass = 'bg-danger';
            %>
            <a href="#" class="list-group-item list-group-item-action py-3 d-flex justify-content-between align-items-center" data-bs-toggle="modal" data-bs-target="#leaveModal_<%= l._id %>">
              <div>
                <div class="fw-bold text-primary mb-1"><%= l.officer ? l.officer.hoTen : 'Đã xóa cán bộ' %></div>
                <div class="small text-muted"><%= fmtDateMobile(l.tuNgay) %> - <%= fmtDateMobile(l.denNgay) %> (<%= l.soNgayNghi %> ngày)</div>
              </div>
              <div>
                <span class="badge <%= bClass %>"><%= status %></span>
              </div>
            </a>

            <!-- Modal for mobile -->
            <div class="modal fade" id="leaveModal_<%= l._id %>" tabindex="-1" aria-hidden="true">
              <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content border-0 shadow">
                  <div class="modal-header bg-light">
                    <h5 class="modal-title fw-bold">Chi tiết đơn nghỉ phép</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                  </div>
                  <div class="modal-body p-4">
                    <div class="d-flex justify-content-between mb-3 border-bottom pb-2">
                      <span class="text-muted small">Cán bộ</span>
                      <span class="fw-semibold"><%= l.officer ? l.officer.hoTen : 'Đã xóa cán bộ' %></span>
                    </div>
                    <div class="d-flex justify-content-between mb-3 border-bottom pb-2">
                      <span class="text-muted small">Thời gian</span>
                      <span class="fw-semibold"><%= fmtDateMobile(l.tuNgay) %> đến <%= fmtDateMobile(l.denNgay) %></span>
                    </div>
                    <div class="d-flex justify-content-between mb-3 border-bottom pb-2">
                      <span class="text-muted small">Số ngày</span>
                      <span class="fw-bold text-primary"><%= l.soNgayNghi %> ngày</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3 border-bottom pb-2">
                      <span class="text-muted small">Loại phép</span>
                      <span class="badge bg-secondary"><%= l.loaiPhep || 'Phép năm' %></span>
                    </div>
                    <div class="mb-3 border-bottom pb-2">
                      <span class="text-muted small d-block mb-1">Lý do cụ thể</span>
                      <span class="fw-medium"><%= l.lyDo %></span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                      <span class="text-muted small">Trạng thái</span>
                      <span class="badge <%= bClass %> fs-6"><%= status %></span>
                    </div>
                    
                    <% if (currentUser && ['admin','editor'].includes(currentUser.role)) { %>
                      <div class="mt-4 pt-3 border-top d-flex flex-column gap-2">
                        <form action="/leaves/<%= l._id %>?_method=DELETE" method="POST" class="delete-form" data-confirm="Xác nhận xóa lịch sử này?">
                          <button type="submit" class="btn btn-outline-danger w-100"><i class="fas fa-trash me-2"></i>Xóa đơn nghỉ phép</button>
                        </form>
                      </div>
                    <% } %>
                  </div>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>

    <!-- Desktop Table View -->
    <div class="table-responsive d-none d-md-block">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th class="ps-3">Cán bộ</th>
            <th>Thời gian</th>
            <th>Số ngày</th>
            <th>Loại phép</th>
            <th>Lý do</th>
            <th>Trạng thái</th>
            <% if (currentUser && ['admin','editor'].includes(currentUser.role)) { %>
            <th class="text-end pe-3">Thao tác</th>
            <% } %>
          </tr>
        </thead>
        <tbody>
          <% const fmtDate = d => d ? new Date(d).toLocaleDateString('vi-VN') : '-'; %>
          <% allLeaves.forEach(l => { %>
            <tr>
              <td class="ps-3">
                <% if(l.officer) { %>
                  <div class="fw-bold text-primary">
                    <a href="/leaves/<%= l.officer._id %>?year=<%= year %>" class="text-decoration-none"><%= l.officer.hoTen %></a>
                  </div>
                  <div class="small text-muted"><%= l.officer.chucVu %></div>
                <% } else { %>
                  <span class="text-muted">Đã xóa cán bộ</span>
                <% } %>
              </td>
              <td>
                <span class="badge bg-light text-dark border"><%= fmtDate(l.tuNgay) %> - <%= fmtDate(l.denNgay) %></span>
              </td>
              <td class="fw-bold text-center"><%= l.soNgayNghi %></td>
              <td><span class="badge bg-secondary"><%= l.loaiPhep || 'Phép năm' %></span></td>
              <td><small><%= l.lyDo %></small></td>
              <td>
                <% 
                  let bClass = 'bg-warning text-dark';
                  let status = l.trangThai || 'Đã duyệt';
                  if(status === 'Đã duyệt') bClass = 'bg-success';
                  if(status === 'Từ chối') bClass = 'bg-danger';
                %>
                <span class="badge <%= bClass %>"><%= status %></span>
              </td>
              <% if (currentUser && ['admin','editor'].includes(currentUser.role)) { %>
              <td class="text-end pe-3">
                <form action="/leaves/<%= l._id %>?_method=DELETE" method="POST" class="d-inline delete-form" data-confirm="Xóa lịch sử nghỉ phép này?">
                  <button type="submit" class="btn btn-sm btn-outline-danger border-0"><i class="fas fa-trash"></i></button>
                </form>
              </td>
              <% } %>
            </tr>
          <% }) %>
          <% if (allLeaves.length === 0) { %>
            <tr><td colspan="7" class="text-center text-muted py-4">Chưa có đơn xin nghỉ phép nào</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
