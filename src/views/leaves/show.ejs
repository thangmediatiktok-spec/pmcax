<%- include('../partials/header', { activeMenu: 'leaves' }) %>
<%- include('../partials/flash') %>

<% const fmtDate = d => d ? new Date(d).toLocaleDateString('vi-VN') : '-'; %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h5 class="fw-bold mb-0 text-primary">Lịch sử nghỉ phép: <%= officer.hoTen %></h5>
    <small class="text-muted">Số hiệu: <%= officer.maSo %> | Chức vụ: <%= officer.chucVu %></small>
  </div>
  <div class="d-flex gap-2">
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addLeaveModal">
      <i class="fas fa-plus me-1"></i> Thêm đơn xin nghỉ
    </button>
    <a href="/leaves?year=<%= year %>" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-1"></i>Quay lại</a>
  </div>
</div>

<div class="row g-3">
  <!-- Leave Balance Card -->
  <div class="col-lg-4">
    <div class="card border-0 shadow-sm mb-3">
      <div class="card-header bg-white py-3 border-bottom border-light">
        <h6 class="mb-0 fw-semibold text-primary"><i class="fas fa-chart-pie me-2"></i>Quỹ phép năm <%= year %></h6>
      </div>
      <div class="card-body p-4">
        <div class="d-flex justify-content-between mb-3 align-items-center">
          <span class="text-muted">Tổng phép năm (Tiêu chuẩn):</span>
          <span class="fw-bold fs-5 text-primary"><%= allowed %> <small class="fs-6 fw-normal">ngày</small></span>
        </div>
        <div class="d-flex justify-content-between mb-3 align-items-center">
          <span class="text-muted">Đã sử dụng (Đã duyệt):</span>
          <span class="fw-bold fs-5 text-danger"><%= taken %> <small class="fs-6 fw-normal">ngày</small></span>
        </div>
        <hr class="bg-light">
        <div class="d-flex justify-content-between align-items-center">
          <span class="fw-semibold">Còn lại:</span>
          <span class="fw-bold fs-4 text-success"><%= remaining %> <small class="fs-6 fw-normal">ngày</small></span>
        </div>
        <div class="mt-3 small text-muted fst-italic">
          * Quỹ phép năm chỉ bị trừ khi loại phép là "Phép năm" và trạng thái đã được duyệt.
        </div>
      </div>
    </div>
  </div>

  <!-- Leave History Timeline/Table -->
  <div class="col-lg-8">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-header bg-white py-3 border-bottom border-light d-flex justify-content-between align-items-center">
        <h6 class="mb-0 fw-semibold"><i class="fas fa-list text-primary me-2"></i>Chi tiết các lần nghỉ trong năm <%= year %></h6>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover mb-0 align-middle">
            <thead class="table-light">
              <tr>
                <th class="ps-3" style="width:40px">#</th>
                <th>Thời gian</th>
                <th>Số ngày</th>
                <th>Loại phép</th>
                <th>Lý do</th>
                <th>Trạng thái</th>
                <% if (currentUser && ['admin','editor'].includes(currentUser.role)) { %>
                <th style="width:100px" class="text-end pe-3">Thao tác</th>
                <% } %>
              </tr>
            </thead>
            <tbody>
              <% history.forEach((h, i) => { %>
              <tr>
                <td class="ps-3 text-muted small"><%= i + 1 %></td>
                <td>
                  <span class="badge bg-light text-dark border"><%= fmtDate(h.tuNgay) %> - <%= fmtDate(h.denNgay) %></span>
                </td>
                <td class="fw-bold text-center"><%= h.soNgayNghi %></td>
                <td><span class="badge bg-secondary"><%= h.loaiPhep || 'Phép năm' %></span></td>
                <td><small><%= h.lyDo %></small></td>
                <td>
                  <% 
                    let bClass = 'bg-warning text-dark';
                    let status = h.trangThai || 'Đã duyệt';
                    if(status === 'Đã duyệt') bClass = 'bg-success';
                    if(status === 'Từ chối') bClass = 'bg-danger';
                  %>
                  <span class="badge <%= bClass %>"><%= status %></span>
                </td>
                <% if (currentUser && ['admin','editor'].includes(currentUser.role)) { %>
                <td class="text-end pe-3">
                  <% if (status === 'Chờ duyệt') { %>
                    <form action="/leaves/<%= h._id %>/status?_method=PATCH" method="POST" class="d-inline">
                      <input type="hidden" name="trangThai" value="Đã duyệt">
                      <button type="submit" class="btn btn-sm btn-outline-success" title="Duyệt"><i class="fas fa-check"></i></button>
                    </form>
                    <form action="/leaves/<%= h._id %>/status?_method=PATCH" method="POST" class="d-inline">
                      <input type="hidden" name="trangThai" value="Từ chối">
                      <button type="submit" class="btn btn-sm btn-outline-danger" title="Từ chối"><i class="fas fa-times"></i></button>
                    </form>
                  <% } else { %>
                    <form action="/leaves/<%= h._id %>?_method=DELETE" method="POST" class="d-inline delete-form" data-confirm="Xóa lịch sử nghỉ phép này?">
                      <button type="submit" class="btn btn-sm btn-outline-danger border-0"><i class="fas fa-trash"></i></button>
                    </form>
                  <% } %>
                </td>
                <% } %>
              </tr>
              <% }) %>
              <% if (history.length === 0) { %>
              <tr>
                <td colspan="7" class="text-center py-5 text-muted">Chưa có lịch sử nghỉ phép trong năm này</td>
              </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Modal Thêm Đơn Nghỉ Phép -->
<div class="modal fade" id="addLeaveModal" tabindex="-1" aria-labelledby="addLeaveModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content border-0 shadow">
      <form action="/leaves" method="POST">
        <input type="hidden" name="officer" value="<%= officer._id %>">
        <div class="modal-header bg-light">
          <h5 class="modal-title fw-bold" id="addLeaveModalLabel">Thêm Đơn Xin Nghỉ Phép</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body p-4">
          <div class="row g-3">
            <div class="col-12">
              <label class="form-label small fw-semibold">Loại phép</label>
              <select name="loaiPhep" class="form-select">
                <option value="Phép năm">Phép năm</option>
                <option value="Nghỉ bù">Nghỉ bù</option>
                <option value="Việc riêng">Việc riêng</option>
                <option value="Ốm đau">Ốm đau</option>
                <option value="Thai sản">Thai sản</option>
                <option value="Khác">Khác</option>
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Từ ngày <span class="text-danger">*</span></label>
              <input type="date" name="tuNgay" class="form-control" required>
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Đến ngày <span class="text-danger">*</span></label>
              <input type="date" name="denNgay" class="form-control" required>
            </div>
            <div class="col-12">
              <label class="form-label small fw-semibold">Lý do cụ thể <span class="text-danger">*</span></label>
              <textarea name="lyDo" class="form-control" rows="3" placeholder="Ghi chú thêm lý do nghỉ..." required></textarea>
            </div>
          </div>
          <% if (currentUser && ['admin','editor'].includes(currentUser.role)) { %>
            <div class="alert alert-info mt-3 mb-0 small py-2">
              <i class="fas fa-info-circle me-1"></i> Quản trị viên thêm đơn sẽ tự động được gán trạng thái <strong>Đã duyệt</strong>.
            </div>
          <% } else { %>
            <div class="alert alert-warning mt-3 mb-0 small py-2">
              <i class="fas fa-info-circle me-1"></i> Đơn xin nghỉ của bạn sẽ ở trạng thái <strong>Chờ duyệt</strong> cho đến khi Quản trị viên xử lý.
            </div>
          <% } %>
        </div>
        <div class="modal-footer bg-light">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
          <button type="submit" class="btn btn-primary"><i class="fas fa-paper-plane me-1"></i> Gửi đơn</button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
