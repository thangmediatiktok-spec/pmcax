<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="icon" href="/images/logo.png" type="image/png">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <style>
    body { background: #f8f9fa; padding: 40px 0; font-family: "Segoe UI", Arial, sans-serif; }
    .onboarding-card { border: none; border-radius: 12px; box-shadow: 0 10px 30px rgba(0,0,0,0.05); overflow: hidden; }
    .card-header-step { padding: 30px 20px; border-bottom: none; display: flex; align-items: center; }
    .step-indicator { width: 30px; height: 30px; border-radius: 50%; background: rgba(255,255,255,0.2); display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 14px; margin-right: 15px; }
    .step-indicator.active { background: #e63946; color: white; box-shadow: 0 0 0 4px rgba(230,57,70,0.3); }
    .btn-submit { background: linear-gradient(135deg,#e63946,#c1121f); border: none; padding: 12px 25px; font-weight: 600; color: white; border-radius: 8px; }
    .btn-submit:hover { background: linear-gradient(135deg,#c1121f,#a00f1a); color: white; }
  </style>
</head>
<body>
  <div class="container" style="max-width: 600px;">
    <div class="text-center mb-4">
      <img src="/images/logo.png" alt="Logo" style="height: 80px;" class="mb-3">
      <h4 class="fw-bold text-danger">CHÀO MỪNG ĐẾN VỚI HỆ THỐNG PMCAX</h4>
      <p class="text-muted">Vui lòng hoàn tất thiết lập ban đầu trước khi truy cập.</p>
    </div>
    
    <div class="onboarding-card card">
      <div class="card-header-step text-white" style="background: linear-gradient(135deg, #2d3748, #4a5568);">
        <div class="step-indicator active">1</div>
        <div>
          <h4 class="mb-0 fw-bold">Bước 1: Đổi mật khẩu mặc định (BẮT BUỘC)</h4>
          <p class="mb-0 mt-1 text-light" style="opacity: 0.8; font-size: 14px;">Bảo vệ tài khoản của bạn ngay lần đầu đăng nhập</p>
        </div>
      </div>
      
      <div class="card-body p-4 p-md-5">
        <%- include('../partials/flash') %>
        
        <form action="/onboarding/password" method="POST">
          <div class="mb-3">
            <label class="form-label fw-bold">Mật khẩu hiện tại (mặc định) <span class="text-danger">*</span></label>
            <input type="password" name="oldPassword" class="form-control form-control-lg" required>
          </div>
          
          <div class="mb-3">
            <label class="form-label fw-bold">Mật khẩu mới <span class="text-danger">*</span></label>
            <input type="password" name="newPassword" class="form-control form-control-lg" required minlength="6">
            <div class="form-text">Mật khẩu phải có ít nhất 6 ký tự.</div>
          </div>
          
          <div class="mb-4">
            <label class="form-label fw-bold">Xác nhận mật khẩu mới <span class="text-danger">*</span></label>
            <input type="password" name="confirmPassword" class="form-control form-control-lg" required minlength="6">
          </div>
          
          <div class="text-end mt-4">
            <a href="/logout" class="btn btn-outline-secondary me-2"><i class="fas fa-sign-out-alt me-1"></i>Đăng xuất</a>
            <button type="submit" class="btn btn-submit"><i class="fas fa-check-circle me-2"></i>Đổi mật khẩu & Tiếp tục</button>
          </div>
        </form>
      </div>
    </div>
  </div>
  
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
