<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="icon" href="/images/logo.png" type="image/png">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <style>
    body { background: #f8f9fa; padding: 40px 0; font-family: "Segoe UI", Arial, sans-serif; }
    .onboarding-card { border: none; border-radius: 12px; box-shadow: 0 10px 30px rgba(0,0,0,0.05); overflow: hidden; }
    .card-header-step { padding: 30px 20px; border-bottom: none; display: flex; align-items: center; }
    .step-indicator { width: 30px; height: 30px; border-radius: 50%; background: rgba(255,255,255,0.2); display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 14px; margin-right: 15px; }
    .step-indicator.active { background: #e63946; color: white; box-shadow: 0 0 0 4px rgba(230,57,70,0.3); }
    .btn-submit { background: linear-gradient(135deg,#e63946,#c1121f); border: none; padding: 12px 25px; font-weight: 600; color: white; border-radius: 8px; }
    .btn-submit:hover { background: linear-gradient(135deg,#c1121f,#a00f1a); color: white; }
    .btn-submit:disabled { background: #6c757d; cursor: not-allowed; }
    .password-req { font-size: 13px; color: #6c757d; margin-bottom: 3px; display: flex; align-items: center; }
    .password-req i { width: 15px; margin-right: 5px; }
    .req-met { color: #198754; }
    .req-unmet { color: #dc3545; }
    .progress { height: 6px; border-radius: 3px; background-color: #e9ecef; }
  </style>
</head>
<body>
  <div class="container" style="max-width: 600px;">
    <div class="text-center mb-4">
      <img src="/images/logo.png" alt="Logo" style="height: 80px;" class="mb-3">
      <h4 class="fw-bold text-danger">CHÀO MỪNG ĐẾN VỚI HỆ THỐNG PMCAX</h4>
      <p class="text-muted">Vui lòng hoàn tất thiết lập ban đầu trước khi truy cập.</p>
    </div>
    
    <div class="onboarding-card card">
      <div class="card-header-step text-white" style="background: linear-gradient(135deg, #2d3748, #4a5568);">
        <div class="step-indicator active">1</div>
        <div>
          <h4 class="mb-0 fw-bold">Bước 1: Đổi mật khẩu mặc định (BẮT BUỘC)</h4>
          <p class="mb-0 mt-1 text-light" style="opacity: 0.8; font-size: 14px;">Bảo vệ tài khoản của bạn ngay lần đầu đăng nhập</p>
        </div>
      </div>
      
      <div class="card-body p-4 p-md-5">
        <%- include('../partials/flash') %>
        
        <form action="/onboarding/password" method="POST">
          <div class="mb-3">
            <label class="form-label fw-bold">Mật khẩu hiện tại (mặc định) <span class="text-danger">*</span></label>
            <input type="password" name="oldPassword" class="form-control form-control-lg" required>
          </div>
          
          <div class="mb-3">
            <label class="form-label fw-bold">Mật khẩu mới <span class="text-danger">*</span></label>
            <input type="password" name="newPassword" id="newPassword" class="form-control form-control-lg" required>
            
            <!-- Password strength indicator -->
            <div class="mt-2 mb-1">
              <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="small fw-semibold" id="strengthText">Độ mạnh: Chưa nhập</span>
              </div>
              <div class="progress mb-2">
                <div class="progress-bar" id="strengthBar" role="progressbar" style="width: 0%" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
              </div>
            </div>
            
            <div class="bg-light p-2 rounded border">
              <div class="password-req" id="req-length"><i class="fas fa-times-circle req-unmet"></i> Ít nhất 8 ký tự</div>
              <div class="password-req" id="req-upper"><i class="fas fa-times-circle req-unmet"></i> Ít nhất 1 chữ hoa (A-Z)</div>
              <div class="password-req" id="req-lower"><i class="fas fa-times-circle req-unmet"></i> Ít nhất 1 chữ thường (a-z)</div>
              <div class="password-req" id="req-number"><i class="fas fa-times-circle req-unmet"></i> Ít nhất 1 chữ số (0-9)</div>
              <div class="password-req" id="req-special"><i class="fas fa-times-circle req-unmet"></i> Ít nhất 1 ký tự đặc biệt (!@#$...)</div>
            </div>
          </div>
          
          <div class="mb-4">
            <label class="form-label fw-bold">Xác nhận mật khẩu mới <span class="text-danger">*</span></label>
            <input type="password" name="confirmPassword" id="confirmPassword" class="form-control form-control-lg" required>
            <div id="matchMessage" class="small mt-1 fw-semibold d-none">
              <i class="fas fa-check-circle text-success me-1"></i> Mật khẩu trùng khớp
            </div>
          </div>
          
          <div class="text-end mt-4">
            <a href="/logout" class="btn btn-outline-secondary me-2"><i class="fas fa-sign-out-alt me-1"></i>Đăng xuất</a>
            <button type="submit" class="btn btn-submit"><i class="fas fa-check-circle me-2"></i>Đổi mật khẩu & Tiếp tục</button>
          </div>
        </form>
      </div>
    </div>
  </div>
  
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    const newPassword = document.getElementById('newPassword');
    const confirmPassword = document.getElementById('confirmPassword');
    const btnSubmit = document.querySelector('.btn-submit');
    const matchMessage = document.getElementById('matchMessage');
    
    // Requirements elements
    const reqLength = document.getElementById('req-length');
    const reqUpper = document.getElementById('req-upper');
    const reqLower = document.getElementById('req-lower');
    const reqNumber = document.getElementById('req-number');
    const reqSpecial = document.getElementById('req-special');
    
    const strengthBar = document.getElementById('strengthBar');
    const strengthText = document.getElementById('strengthText');

    let isPasswordStrong = false;
    let isPasswordMatch = false;

    function updateSubmitButton() {
      if (isPasswordStrong && isPasswordMatch) {
        btnSubmit.disabled = false;
      } else {
        btnSubmit.disabled = true;
      }
    }

    function checkRequirement(element, condition) {
      const icon = element.querySelector('i');
      if (condition) {
        icon.className = 'fas fa-check-circle req-met';
        element.style.color = '#198754';
        return 1;
      } else {
        icon.className = 'fas fa-times-circle req-unmet';
        element.style.color = '#6c757d';
        return 0;
      }
    }

    newPassword.addEventListener('input', function() {
      const val = this.value;
      let score = 0;
      
      score += checkRequirement(reqLength, val.length >= 8);
      score += checkRequirement(reqUpper, /[A-Z]/.test(val));
      score += checkRequirement(reqLower, /[a-z]/.test(val));
      score += checkRequirement(reqNumber, /\d/.test(val));
      score += checkRequirement(reqSpecial, /[\W_]/.test(val)); // non-word chars or underscore
      
      // Update bar
      strengthBar.style.width = (score * 20) + '%';
      
      if (score === 0) {
        strengthBar.className = 'progress-bar bg-secondary';
        strengthText.innerText = 'Độ mạnh: Chưa nhập';
        isPasswordStrong = false;
      } else if (score < 3) {
        strengthBar.className = 'progress-bar bg-danger';
        strengthText.innerText = 'Độ mạnh: Yếu';
        strengthText.className = 'small fw-semibold text-danger';
        isPasswordStrong = false;
      } else if (score < 5) {
        strengthBar.className = 'progress-bar bg-warning';
        strengthText.innerText = 'Độ mạnh: Trung bình';
        strengthText.className = 'small fw-semibold text-warning';
        isPasswordStrong = false;
      } else {
        strengthBar.className = 'progress-bar bg-success';
        strengthText.innerText = 'Độ mạnh: Tốt';
        strengthText.className = 'small fw-semibold text-success';
        isPasswordStrong = true;
      }
      
      checkMatch();
      updateSubmitButton();
    });

    function checkMatch() {
      if (confirmPassword.value.length > 0) {
        matchMessage.classList.remove('d-none');
        if (newPassword.value === confirmPassword.value) {
          matchMessage.innerHTML = '<i class="fas fa-check-circle text-success me-1"></i> Mật khẩu trùng khớp';
          matchMessage.className = 'small mt-1 fw-semibold text-success';
          isPasswordMatch = true;
        } else {
          matchMessage.innerHTML = '<i class="fas fa-times-circle text-danger me-1"></i> Mật khẩu chưa khớp';
          matchMessage.className = 'small mt-1 fw-semibold text-danger';
          isPasswordMatch = false;
        }
      } else {
        matchMessage.classList.add('d-none');
        isPasswordMatch = false;
      }
    }

    confirmPassword.addEventListener('input', function() {
      checkMatch();
      updateSubmitButton();
    });
    
    // Disable submit button on load
    updateSubmitButton();
  </script>
</body>
</html>
