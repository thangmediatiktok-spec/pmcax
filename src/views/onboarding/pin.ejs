<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="icon" type="image/x-icon" href="/images/logo.png">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <style>
    body {
      background-color: #f8f9fa;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background-image: url('/images/trong-dong.png');
      background-size: 600px;
      background-position: center;
      background-repeat: no-repeat;
      background-attachment: fixed;
    }
    body::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(248, 249, 250, 0.95);
      z-index: -1;
    }
    .onboarding-card {
      border: none;
      border-radius: 15px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.08);
      overflow: hidden;
    }
    .card-header-step {
      padding: 25px;
      display: flex;
      align-items: center;
      gap: 20px;
    }
    .step-indicator {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: rgba(255,255,255,0.2);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: bold;
      font-size: 1.2rem;
    }
    .step-indicator.active {
      background: #fff;
      color: #0d6efd;
    }
    
    .pin-input-group {
      display: flex;
      justify-content: space-between;
      gap: 10px;
    }
    .pin-input {
      width: 50px;
      height: 60px;
      font-size: 24px;
      text-align: center;
      border: 2px solid #ced4da;
      border-radius: 8px;
      font-weight: bold;
      color: #2c3e50;
      transition: all 0.3s;
    }
    .pin-input:focus {
      border-color: #0d6efd;
      box-shadow: 0 0 0 0.25rem rgba(13,110,253,.25);
      outline: none;
    }
    
    .btn-submit {
      padding: 12px;
      font-weight: 600;
      letter-spacing: 0.5px;
      border-radius: 8px;
    }
  </style>
</head>
<body>
  <div class="container" style="max-width: 500px;">
    <div class="text-center mb-4">
      <img src="/images/logo.png" alt="Logo" style="height: 80px;" class="mb-3">
      <h4 class="fw-bold text-danger">CHÀO MỪNG ĐẾN VỚI HỆ THỐNG PMCAX</h4>
      <p class="text-muted">Vui lòng hoàn tất thiết lập ban đầu trước khi truy cập.</p>
    </div>
    
    <div class="onboarding-card card">
      <div class="card-header-step text-white" style="background: linear-gradient(135deg, #0d6efd, #0b5ed7);">
        <div class="step-indicator active"><i class="fas fa-lock"></i></div>
        <div>
          <h4 class="mb-0 fw-bold">Bước 1.5: Mã PIN Bảo mật</h4>
          <p class="mb-0 mt-1 text-light" style="opacity: 0.9; font-size: 14px;">Bảo vệ dữ liệu hồ sơ Tối Mật</p>
        </div>
      </div>
      
      <div class="card-body p-4 p-md-5">
        <%- include('../partials/flash') %>
        
        <p class="text-muted mb-4">
          <i class="fas fa-info-circle text-primary me-2"></i> Hệ thống PMCAX chứa các dữ liệu <strong>Tối Mật</strong>. Vui lòng thiết lập Mã PIN gồm 6 số để hệ thống xác thực khi bạn (hoặc người mượn máy bạn) truy cập xem chi tiết Hồ sơ CBCS.
        </p>

        <form action="/onboarding/pin/setup" method="POST" id="pinForm">
          <input type="hidden" name="pinCode" id="pinCodeInput">
          <input type="hidden" name="confirmPinCode" id="confirmPinCodeInput">
          
          <div class="mb-4">
            <label class="form-label fw-bold">Nhập Mã PIN mới (6 số)</label>
            <div class="pin-input-group" id="pin-group-1">
              <input type="password" class="pin-input" maxlength="1" pattern="\d*" inputmode="numeric" required>
              <input type="password" class="pin-input" maxlength="1" pattern="\d*" inputmode="numeric" required>
              <input type="password" class="pin-input" maxlength="1" pattern="\d*" inputmode="numeric" required>
              <input type="password" class="pin-input" maxlength="1" pattern="\d*" inputmode="numeric" required>
              <input type="password" class="pin-input" maxlength="1" pattern="\d*" inputmode="numeric" required>
              <input type="password" class="pin-input" maxlength="1" pattern="\d*" inputmode="numeric" required>
            </div>
          </div>
          
          <div class="mb-5">
            <label class="form-label fw-bold">Xác nhận lại Mã PIN</label>
            <div class="pin-input-group" id="pin-group-2">
              <input type="password" class="pin-input" maxlength="1" pattern="\d*" inputmode="numeric" required>
              <input type="password" class="pin-input" maxlength="1" pattern="\d*" inputmode="numeric" required>
              <input type="password" class="pin-input" maxlength="1" pattern="\d*" inputmode="numeric" required>
              <input type="password" class="pin-input" maxlength="1" pattern="\d*" inputmode="numeric" required>
              <input type="password" class="pin-input" maxlength="1" pattern="\d*" inputmode="numeric" required>
              <input type="password" class="pin-input" maxlength="1" pattern="\d*" inputmode="numeric" required>
            </div>
            <div id="pinMatchError" class="text-danger mt-2 small" style="display: none;">
              <i class="fas fa-exclamation-triangle me-1"></i> Mã PIN xác nhận không khớp!
            </div>
          </div>
          
          <button type="submit" class="btn btn-primary btn-submit w-100">
            Lưu Mã PIN & Tiếp tục <i class="fas fa-arrow-right ms-2"></i>
          </button>
        </form>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    function setupPinInputs(groupId, hiddenInputId) {
      const group = document.getElementById(groupId);
      const inputs = group.querySelectorAll('.pin-input');
      const hiddenInput = document.getElementById(hiddenInputId);
      
      inputs.forEach((input, index) => {
        // Handle input
        input.addEventListener('input', function(e) {
          // Allow only numbers
          this.value = this.value.replace(/[^0-9]/g, '');
          
          if (this.value) {
            if (index < inputs.length - 1) {
              inputs[index + 1].focus();
            }
          }
          updateHiddenInput();
        });
        
        // Handle backspace
        input.addEventListener('keydown', function(e) {
          if (e.key === 'Backspace' && !this.value && index > 0) {
            inputs[index - 1].focus();
            inputs[index - 1].value = '';
          }
          updateHiddenInput();
        });
        
        // Handle paste
        input.addEventListener('paste', function(e) {
          e.preventDefault();
          const pastedData = e.clipboardData.getData('text').replace(/[^0-9]/g, '').slice(0, 6);
          if (pastedData) {
            for (let i = 0; i < pastedData.length; i++) {
              if (inputs[i]) inputs[i].value = pastedData[i];
            }
            if (pastedData.length < 6) {
              inputs[pastedData.length].focus();
            } else {
              inputs[5].focus();
            }
            updateHiddenInput();
          }
        });
      });
      
      function updateHiddenInput() {
        let pin = '';
        inputs.forEach(input => pin += input.value);
        hiddenInput.value = pin;
        validateMatch();
      }
    }
    
    function validateMatch() {
      const pin1 = document.getElementById('pinCodeInput').value;
      const pin2 = document.getElementById('confirmPinCodeInput').value;
      const errorDiv = document.getElementById('pinMatchError');
      
      if (pin1.length === 6 && pin2.length === 6 && pin1 !== pin2) {
        errorDiv.style.display = 'block';
      } else {
        errorDiv.style.display = 'none';
      }
    }
    
    document.getElementById('pinForm').addEventListener('submit', function(e) {
      const pin1 = document.getElementById('pinCodeInput').value;
      const pin2 = document.getElementById('confirmPinCodeInput').value;
      
      if (pin1.length !== 6 || pin2.length !== 6) {
        e.preventDefault();
        alert('Vui lòng nhập đủ 6 số cho Mã PIN.');
        return;
      }
      
      if (pin1 !== pin2) {
        e.preventDefault();
        document.getElementById('pinMatchError').style.display = 'block';
        return;
      }
    });

    setupPinInputs('pin-group-1', 'pinCodeInput');
    setupPinInputs('pin-group-2', 'confirmPinCodeInput');
    
    // Focus first input on load
    document.querySelector('#pin-group-1 .pin-input').focus();
  </script>
</body>
</html>
