<%- include('../partials/header', { activeMenu: 'rosters' }) %>
<%- include('../partials/flash') %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h5 class="fw-bold mb-0"><i class="fas fa-calendar-alt text-primary me-2"></i>Quản lý Lịch trực</h5>
  <% if (typeof canManage !== 'undefined' && canManage) { %>
    <a href="/rosters/create" class="btn btn-primary btn-sm"><i class="fas fa-plus me-1"></i>Tạo Lịch trực</a>
  <% } %>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0 align-middle">
        <thead class="table-light">
          <tr>
            <th class="ps-3">Tuần / Ngày</th>
            <th>Trạng thái</th>
            <th>Người tạo</th>
            <th>Ngày tạo</th>
            <th class="text-end pe-3">Thao tác</th>
          </tr>
        </thead>
        <tbody>
          <% if (rosters && rosters.length > 0) { %>
            <% rosters.forEach(roster => { %>
              <% 
                const d1 = new Date(roster.weekStart).toLocaleDateString('vi-VN');
                const d2 = new Date(roster.weekEnd).toLocaleDateString('vi-VN');
              %>
            <tr>
              <td class="ps-3 fw-medium">
                Tuần từ ngày <%= d1 %> đến <%= d2 %>
              </td>
              <td><span class="badge bg-success">Đã ban hành</span></td>
              <td><%= roster.createdBy ? roster.createdBy.hoTen : '-' %></td>
              <td><%= new Date(roster.createdAt).toLocaleDateString('vi-VN') %></td>
              <td class="text-end pe-3">
                <a href="/rosters/<%= roster._id %>" class="btn btn-sm btn-outline-info" title="Xem chi tiết"><i class="fas fa-eye"></i></a>
                <% if (typeof canManage !== 'undefined' && canManage) { %>
                <a href="/rosters/<%= roster._id %>/edit" class="btn btn-sm btn-outline-warning" title="Chỉnh sửa"><i class="fas fa-edit"></i></a>
                <form action="/rosters/<%= roster._id %>?_method=DELETE" method="POST" class="d-inline delete-form" data-confirm="Xác nhận xóa lịch trực tuần này?">
                  <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa"><i class="fas fa-trash"></i></button>
                </form>
                <% } %>
              </td>
            </tr>
            <% }) %>
          <% } else { %>
            <tr><td colspan="5" class="text-center text-muted py-4">Chưa có dữ liệu lịch trực</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
