<%- include('../partials/header', { activeMenu: 'rosters' }) %>
<%- include('../partials/flash') %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h5 class="fw-bold mb-0"><i class="fas fa-magic text-warning me-2"></i>Tạo Lịch trực</h5>
  <a href="/rosters" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-left me-1"></i>Quay lại</a>
</div>

<div class="row">
  <div class="col-md-6">
    <div class="card border-0 shadow-sm">
      <div class="card-body p-4 text-center">
        <h5 class="fw-bold text-primary mb-3">Xếp lịch Tự Động</h5>
        <p class="text-muted small mb-4">Hệ thống sẽ tự động quét danh sách cán bộ chiến sĩ, phân bổ xoay vòng ngẫu nhiên để xếp lịch trực trong 7 ngày (Từ thứ 2 đến Chủ nhật) cho tuần tiếp theo hoặc tuần được chọn.</p>
        <form action="/rosters/auto" method="POST">
          <div class="mb-3 text-start">
            <label class="form-label fw-semibold">Chọn ngày bắt đầu (Thứ 2)</label>
            <input type="date" name="startDate" class="form-control" required>
            <div class="form-text">Mặc định hệ thống sẽ tự tìm Thứ 2 của tuần tiếp theo nếu bạn để trống. (Vẫn bắt buộc chọn để tránh lỗi)</div>
          </div>
          <button type="submit" class="btn btn-primary w-100 fw-bold"><i class="fas fa-cogs me-2"></i>Xếp lịch tự động</button>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  // Set default date to next Monday
  const d = new Date();
  d.setDate(d.getDate() + ((1 + 7 - d.getDay()) % 7 || 7));
  document.querySelector('input[name="startDate"]').valueAsDate = d;
</script>

<%- include('../partials/footer') %>
