<%- include('../partials/header', { activeMenu: 'rosters' }) %>
<%- include('../partials/flash') %>

<% 
  const d1 = new Date(roster.weekStart).toLocaleDateString('vi-VN');
  const d2 = new Date(roster.weekEnd).toLocaleDateString('vi-VN');
  const daysOfWeek = ['Chủ nhật', 'Thứ hai', 'Thứ ba', 'Thứ tư', 'Thứ năm', 'Thứ sáu', 'Thứ bảy'];
%>

<style>
  @media print {
    body * { visibility: hidden; }
    #printableArea, #printableArea * { visibility: visible; }
    #printableArea { position: absolute; left: 0; top: 0; width: 100%; }
    .no-print { display: none !important; }
    .table-bordered th, .table-bordered td { border: 1px solid #000 !important; }
  }
  .roster-table th, .roster-table td {
    vertical-align: middle;
    text-align: center;
    border: 1px solid #000;
    padding: 8px;
    font-size: 13px;
  }
  .roster-table thead th {
    font-weight: bold;
    background-color: #f8f9fa;
  }
  .highlight-yellow {
    background-color: #ffff00 !important;
    font-weight: bold;
  }
  .title-header {
    text-align: center;
    font-family: 'Times New Roman', Times, serif;
    margin-bottom: 20px;
  }
  .title-header h4 {
    font-weight: bold;
    margin-bottom: 5px;
    font-size: 18px;
  }
  .title-header p {
    font-size: 14px;
    font-style: italic;
  }
</style>

<div class="d-flex justify-content-between align-items-center mb-3 no-print">
  <h5 class="fw-bold mb-0"><i class="fas fa-table text-success me-2"></i>Xem Lịch trực</h5>
  <div class="d-flex gap-2">
    <button onclick="window.print()" class="btn btn-outline-dark btn-sm"><i class="fas fa-print me-1"></i>In bảng Lịch</button>
    <% if (typeof canManage !== 'undefined' && canManage) { %>
      <a href="/rosters/<%= roster._id %>/edit" class="btn btn-warning btn-sm"><i class="fas fa-edit me-1"></i>Sửa</a>
    <% } %>
    <a href="/rosters" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-left me-1"></i>Quay lại</a>
  </div>
</div>

<div class="card border-0 shadow-sm" id="printableArea">
  <div class="card-body p-4" style="background-color: #fff;">
    <div class="title-header">
      <h4>LỊCH TRỰC CHỈ HUY, TRỰC BAN CÔNG AN XÃ</h4>
      <p>Từ ngày <%= d1 %> đến ngày <%= d2 %></p>
    </div>

    <table class="table roster-table table-bordered mb-0">
      <thead>
        <tr>
          <th rowspan="2" style="width: 15%">Ngày trực</th>
          <th rowspan="2" style="width: 20%">Trực chỉ huy</th>
          <th colspan="2">Trực ban</th>
          <th rowspan="2" style="width: 10%">Ghi chú</th>
          <th rowspan="2" style="width: 20%" class="highlight-yellow">Nghỉ trực ban tuần, cơ động...</th>
        </tr>
        <tr>
          <th style="width: 17.5%">Ca từ 7h00 đến 17h00</th>
          <th style="width: 17.5%">Ca từ 17h00 đến 7h00</th>
        </tr>
      </thead>
      <tbody>
        <% roster.days.forEach((day, index) => { 
            const dateObj = new Date(day.date);
            const dateStr = `${daysOfWeek[dateObj.getDay()]} ngày ${dateObj.toLocaleDateString('vi-VN')}`;
        %>
        <tr>
          <!-- Cột Ngày -->
          <td><%= dateStr %></td>
          
          <!-- Cột Chỉ huy -->
          <td>
            <% if (day.trucChiHuy && day.trucChiHuy.length > 0) { %>
              <% day.trucChiHuy.forEach(o => { %>
                <div class="mb-2">
                  <% if (o.capBac) { %><div><%= o.capBac %></div><% } %>
                  <div class="fw-bold"><%= o.hoTen %></div>
                  <% if (o.chucVu) { %><div><%= o.chucVu %></div><% } else { %><div>Cán bộ</div><% } %>
                </div>
              <% }) %>
            <% } %>
          </td>

          <!-- Cột Ca Ngày -->
          <td>
            <% if (day.trucBanNgay && day.trucBanNgay.length > 0) { %>
              <% day.trucBanNgay.forEach(o => { %>
                <div class="mb-2">
                  <% if (o.capBac) { %><div><%= o.capBac %></div><% } %>
                  <div><%= o.hoTen %></div>
                  <div>Cán bộ</div>
                </div>
              <% }) %>
            <% } %>
          </td>

          <!-- Cột Ca Đêm -->
          <td>
            <% if (day.trucBanDem && day.trucBanDem.length > 0) { %>
              <% day.trucBanDem.forEach(o => { %>
                <div class="mb-2">
                  <% if (o.capBac) { %><div><%= o.capBac %></div><% } %>
                  <div><%= o.hoTen %></div>
                  <div>Cán bộ</div>
                </div>
              <% }) %>
            <% } %>
          </td>

          <!-- Cột Ghi chú -->
          <td><%= day.ghiChu || '' %></td>

          <!-- Cột Ghi chú phụ -->
          <td class="highlight-yellow">
            <span style="white-space: pre-line"><%= day.ghiChuPhu || '' %></span>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/footer') %>
