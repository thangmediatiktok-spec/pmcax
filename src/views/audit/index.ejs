<%- include('../partials/header') %>

<div class="container-fluid px-4">
  <div class="d-flex justify-content-between align-items-center mb-4 mt-3">
    <div>
      <h4 class="mb-0 fw-bold text-dark"><i class="fas fa-user-secret text-danger me-2"></i>Nhật ký truy cập Tối mật</h4>
      <p class="text-muted small mb-0">Theo dõi toàn bộ hoạt động xem và chỉnh sửa Hồ sơ cán bộ</p>
    </div>
  </div>

  <div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="bg-light">
            <tr>
              <th class="py-3 px-4">Thời gian</th>
              <th>Người thao tác</th>
              <th>Hành động</th>
              <th>Hồ sơ đích</th>
              <th>Địa chỉ IP</th>
              <th>Thiết bị (User-Agent)</th>
            </tr>
          </thead>
          <tbody>
            <% if (logs && logs.length > 0) { %>
              <% logs.forEach(log => { %>
                <tr>
                  <td class="px-4">
                    <span class="text-nowrap fw-medium"><%= new Date(log.createdAt).toLocaleDateString('vi-VN') %></span><br>
                    <span class="text-muted small"><%= new Date(log.createdAt).toLocaleTimeString('vi-VN') %></span>
                  </td>
                  <td>
                    <% if (log.user) { %>
                      <div class="fw-bold text-primary"><%= log.user.hoTen %></div>
                      <div class="small text-muted"><%= log.user.username %> (<%= log.user.role %>)</div>
                    <% } else { %>
                      <span class="text-muted">Hệ thống</span>
                    <% } %>
                  </td>
                  <td>
                    <% if (log.action === 'VIEW_PROFILE') { %>
                      <span class="badge bg-info"><i class="fas fa-eye me-1"></i> Xem hồ sơ</span>
                    <% } else if (log.action === 'EDIT_PROFILE') { %>
                      <span class="badge bg-warning"><i class="fas fa-edit me-1"></i> Sửa hồ sơ</span>
                    <% } else if (log.action === 'EXPORT_PROFILE') { %>
                      <span class="badge bg-success"><i class="fas fa-file-excel me-1"></i> Xuất Excel</span>
                    <% } else { %>
                      <span class="badge bg-secondary"><%= log.action %></span>
                    <% } %>
                    <div class="small text-muted mt-1" style="max-width: 200px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="<%= log.details %>">
                      <%= log.details %>
                    </div>
                  </td>
                  <td>
                    <% if (log.targetOfficer) { %>
                      <div class="fw-bold"><%= log.targetOfficer.hoTen %></div>
                      <div class="small text-muted"><%= log.targetOfficer.maSo %></div>
                    <% } else { %>
                      <span class="text-muted">-</span>
                    <% } %>
                  </td>
                  <td><code class="text-dark bg-light px-2 py-1 rounded"><%= log.ipAddress || 'N/A' %></code></td>
                  <td>
                    <div class="small text-muted" style="max-width: 250px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="<%= log.userAgent %>">
                      <%= log.userAgent || 'N/A' %>
                    </div>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="6" class="text-center py-5 text-muted">
                  <i class="fas fa-clipboard-list fa-3x mb-3 opacity-50"></i>
                  <p>Chưa có nhật ký truy cập nào được ghi nhận</p>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
    
    <% if (totalPages > 1) { %>
    <div class="card-footer bg-white py-3">
      <nav>
        <ul class="pagination pagination-sm justify-content-center mb-0">
          <li class="page-item <%= page <= 1 ? 'disabled' : '' %>">
            <a class="page-link" href="?page=<%= page - 1 %>">Trước</a>
          </li>
          <% for(let i = 1; i <= totalPages; i++) { %>
            <li class="page-item <%= page === i ? 'active' : '' %>">
              <a class="page-link" href="?page=<%= i %>"><%= i %></a>
            </li>
          <% } %>
          <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>">
            <a class="page-link" href="?page=<%= page + 1 %>">Sau</a>
          </li>
        </ul>
      </nav>
    </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
