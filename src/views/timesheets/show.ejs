<%- include('../partials/header') %>
<%- include('../partials/flash') %>

<% 
  const isOwner = currentUser && String(currentUser.officerProfile) === String(officer._id);
  const isAdmin = currentUser && (currentUser.role === 'admin' || currentUser.role === 'truong_cax' || currentUser.role === 'pho_cax');
%>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h4 class="fw-bold mb-1 text-primary">
      <i class="fas fa-clipboard-check me-2"></i>Chấm công: <%= officer.hoTen %>
    </h4>
    <div class="d-flex align-items-center gap-2 mt-2">
      <select onchange="window.location.href='/timesheets/<%= year %>/' + this.value + '/<%= officer._id %>'" class="form-select form-select-sm border-secondary text-primary fw-semibold" style="width: auto;">
        <% for(let m=1; m<=12; m++) { %>
          <option value="<%= m %>" <%= m === month ? 'selected' : '' %>>Tháng <%= m %></option>
        <% } %>
      </select>
      <select onchange="window.location.href='/timesheets/' + this.value + '/<%= month %>/<%= officer._id %>'" class="form-select form-select-sm border-secondary text-primary fw-semibold" style="width: auto;">
        <% const currentY = new Date().getFullYear(); %>
        <% for(let y = currentY - 2; y <= currentY + 1; y++) { %>
          <option value="<%= y %>" <%= y === year ? 'selected' : '' %>>Năm <%= y %></option>
        <% } %>
      </select>
    </div>
  </div>
  <div>
    <% if (isAdmin || !isOwner) { %>
      <a href="/timesheets?month=<%= month %>&year=<%= year %>" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-left me-1"></i>Quay lại</a>
    <% } %>
  </div>
</div>

<div class="row g-3 mb-3">
  <!-- Instructions/Legend -->
  <div class="col-12">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-body p-3">
        <h6 class="fw-semibold small mb-2"><i class="fas fa-info-circle text-primary me-2"></i>Ký hiệu chấm công</h6>
        <div class="d-flex flex-wrap gap-3 small">
          <% TIMESHEET_CODES.forEach(c => { %>
            <div>
              <strong class="text-danger"><%= c.code %></strong>: <span class="text-muted"><%= c.label %></span>
            </div>
          <% }) %>
        </div>
        <div class="small text-danger mt-2"><i class="fas fa-exclamation-triangle me-1"></i><strong>Lưu ý:</strong> Mã công tác (CT-A) bắt buộc nhập địa điểm ở dòng "Ghi chú".</div>
      </div>
    </div>
  </div>
</div>

<!-- Main Timesheet Form -->
<div class="card border-0 shadow-sm mb-4">
  <div class="card-body p-0">
    <form action="/timesheets/<%= timesheet._id %>" method="POST" id="timesheetForm">
      <div class="table-responsive">
        <table class="table table-bordered mb-0 align-middle table-sm text-center" style="min-width: 1200px;">
          <thead class="table-light">
            <tr>
              <th style="width: 80px; position: sticky; left: 0; z-index: 2; background: #f8f9fa;" class="text-start px-2 border-end">Ngày</th>
              <% for (let day = 1; day <= daysInMonth; day++) { 
                   const dateObj = new Date(year, month - 1, day);
                   const dayOfWeek = dateObj.getDay(); // 0 is Sunday, 6 is Saturday
                   const isWeekend = (dayOfWeek === 0 || dayOfWeek === 6);
              %>
                <th class="<%= isWeekend ? 'text-danger' : '' %>" style="width: 45px; min-width: 45px; padding: 4px;">
                  <div style="font-size:13px; font-weight:bold;"><%= day %></div>
                  <div style="font-size:10px; font-weight:normal; color:#888;"><%= ['CN', 'T2', 'T3', 'T4', 'T5', 'T6', 'T7'][dayOfWeek] %></div>
                </th>
              <% } %>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="text-start fw-semibold bg-light px-2 border-end" style="position: sticky; left: 0; z-index: 1; font-size: 12px;">Mã công</td>
              <% for (let day = 1; day <= daysInMonth; day++) { 
                   const record = recordMap[day] || { code: '', note: '' }; 
                   const dateObj = new Date(year, month - 1, day);
                   const dayOfWeek = dateObj.getDay();
                   const isWeekend = (dayOfWeek === 0 || dayOfWeek === 6);
              %>
                <td class="<%= isWeekend ? 'bg-light' : '' %> p-0">
                  <select name="code[<%= day %>]" class="form-select form-select-sm code-select text-center rounded-0 border-0" style="font-size:13px; padding: 6px 2px; width:100%; font-weight:bold; cursor:pointer;" data-day="<%= day %>" <%= canEdit ? '' : 'disabled' %>>
                    <option value="">-</option>
                    <% TIMESHEET_CODES.forEach(c => { %>
                      <option value="<%= c.code %>" data-req-note="<%= c.requireNote %>" <%= record.code === c.code ? 'selected' : '' %>>
                        <%= c.code %>
                      </option>
                    <% }) %>
                  </select>
                </td>
              <% } %>
            </tr>
            <tr>
              <td class="text-start fw-semibold bg-light px-2 border-end" style="position: sticky; left: 0; z-index: 1; font-size: 12px;">Ghi chú</td>
              <% for (let day = 1; day <= daysInMonth; day++) { 
                   const record = recordMap[day] || { code: '', note: '' }; 
                   const dateObj = new Date(year, month - 1, day);
                   const dayOfWeek = dateObj.getDay();
                   const isWeekend = (dayOfWeek === 0 || dayOfWeek === 6);
              %>
                <td class="<%= isWeekend ? 'bg-light' : '' %> p-0">
                  <input type="text" name="note[<%= day %>]" id="note-<%= day %>" class="form-control form-control-sm text-center border-0 rounded-0" style="font-size:10px; padding: 6px 2px; width:100%; min-width:45px;" value="<%= record.note %>" placeholder="..." <%= canEdit ? '' : 'disabled' %>>
                </td>
              <% } %>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="card-footer bg-white p-3 border-top">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
          <div class="small text-muted">
            Dữ liệu được lưu trữ tự động vào hồ sơ cá nhân.
          </div>
          <div class="d-flex gap-2">
            <!-- Nút xuất Giấy công tác -->
            <% 
               const hasCT = timesheet.records && timesheet.records.some(r => r.code === 'CT-A');
               const hasADL = timesheet.records && timesheet.records.some(r => r.code === 'A' || r.code === 'CT-A');
            %>
            <a href="/timesheets/<%= timesheet._id %>/adl-preview" class="btn btn-outline-warning fw-semibold <%= !hasADL ? 'disabled' : '' %>" <%= !hasADL ? 'title="Không có ngày Ăn định lượng nào (A hoặc CT-A)" tabindex="-1" aria-disabled="true"' : '' %>>
              <i class="fas fa-hamburger me-1"></i>Bảng Ăn định lượng
            </a>
            
            <button type="button" class="btn btn-outline-success fw-semibold" data-bs-toggle="modal" data-bs-target="#exportCTPModal" <%= !hasCT ? 'disabled title="Không có ngày đi công tác nào (CT-A)"' : '' %>>
              <i class="fas fa-file-pdf me-1"></i>Xuất Giấy đi công tác
            </button>
            
            <% if (canEdit) { %>
              <button type="submit" name="action" value="save" class="btn btn-primary fw-semibold"><i class="fas fa-save me-1"></i>Lưu bảng chấm công</button>
            <% } %>
          </div>
        </div>
      </div>
    </form>
  </div>
</div>

<!-- Modal Xuất Giấy Công Tác -->
<div class="modal fade" id="exportCTPModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow">
      <div class="modal-header bg-success text-white border-0">
        <h5 class="modal-title fw-bold"><i class="fas fa-print me-2"></i>In Giấy đi công tác</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-4">
        <form id="exportCTPForm" action="/timesheets/<%= timesheet._id %>/print-ctp" method="GET" target="_blank">
          <div class="mb-3">
            <label class="form-label fw-semibold">Người ký duyệt (Lãnh đạo)</label>
            <select name="signerId" class="form-select">
              <% if (typeof signers !== 'undefined' && signers.length > 0) { %>
                <% signers.forEach(s => { %>
                  <option value="<%= s._id %>">
                    <%= s.role === 'truong_cax' ? 'Trưởng CAX' : 'Phó Trưởng CAX' %> - <%= s.officerProfile ? s.officerProfile.hoTen : s.username %>
                  </option>
                <% }) %>
              <% } else { %>
                <option value="">Không có dữ liệu lãnh đạo</option>
              <% } %>
            </select>
            <div class="form-text small text-muted">Hệ thống sẽ lấy thông tin chức vụ, cấp bậc và họ tên của lãnh đạo được chọn.</div>
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold">Nội dung chính công tác</label>
            <input type="text" name="purpose" class="form-control" value="Xác minh" required>
          </div>
          <div class="d-flex justify-content-end gap-2 mt-4">
            <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
            <button type="submit" class="btn btn-success fw-semibold" onclick="document.getElementById('exportCTPModal').querySelector('.btn-close').click()"><i class="fas fa-file-pdf me-1"></i>Tạo bản In / PDF</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<style>
  /* Styling to make the dropdown arrow smaller or hidden on narrow columns */
  .code-select {
    background-image: none !important;
    -moz-appearance: none;
    -webkit-appearance: none;
    appearance: none;
  }
  .code-select:focus {
    background-color: #fff3cd;
    outline: none;
    box-shadow: inset 0 0 0 1px #ffc107;
  }
  input.form-control:focus {
    background-color: #fff3cd;
    outline: none;
    box-shadow: inset 0 0 0 1px #ffc107;
  }
  
  /* Make sure the fixed first column looks good */
  td[style*="position: sticky"], th[style*="position: sticky"] {
    box-shadow: 2px 0 5px -2px rgba(0,0,0,0.1);
  }
</style>

<script>
  // Auto-focus logic for required notes
  document.querySelectorAll('.code-select').forEach(select => {
    select.addEventListener('change', function() {
      const option = this.options[this.selectedIndex];
      const requiresNote = option.getAttribute('data-req-note') === 'true';
      const day = this.getAttribute('data-day');
      const noteInput = document.getElementById('note-' + day);
      
      if (requiresNote) {
        noteInput.classList.add('bg-danger', 'text-white');
        noteInput.setAttribute('placeholder', 'BẮT BUỘC...');
        noteInput.focus();
      } else {
        noteInput.classList.remove('bg-danger', 'text-white');
        noteInput.setAttribute('placeholder', '...');
      }
    });
  });

  // Client-side validation to prevent data loss on submit
  document.getElementById('timesheetForm').addEventListener('submit', function(e) {
    let hasError = false;
    let firstErrorInput = null;

    document.querySelectorAll('.code-select').forEach(select => {
      const option = select.options[select.selectedIndex];
      if (option && option.value) {
        const requiresNote = option.getAttribute('data-req-note') === 'true';
        const day = select.getAttribute('data-day');
        const noteInput = document.getElementById('note-' + day);
        
        if (requiresNote && noteInput.value.trim() === '') {
          hasError = true;
          noteInput.classList.add('bg-danger', 'text-white');
          noteInput.setAttribute('placeholder', 'BẮT BUỘC...');
          if (!firstErrorInput) firstErrorInput = noteInput;
        }
      }
    });

    if (hasError) {
      e.preventDefault(); // Stop form submission to prevent data loss
      Swal.fire({
        title: 'Thiếu thông tin!',
        text: 'Bạn chưa nhập Ghi chú cho các ngày đi Công tác (CT-A). Vui lòng kiểm tra các ô màu đỏ.',
        icon: 'error',
        confirmButtonText: 'Đã hiểu'
      }).then(() => {
        if (firstErrorInput) firstErrorInput.focus();
      });
    }
  });
</script>

<%- include('../partials/footer') %>
