<%- include('../partials/header') %>
<%- include('../partials/flash') %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h4 class="fw-bold mb-0 text-primary">
    <i class="fas fa-clipboard-list me-2"></i>Bảng chấm công
  </h4>
</div>

<div class="card border-0 shadow-sm mb-4">
  <div class="card-body p-3">
    <form action="/timesheets" method="GET" class="d-flex flex-wrap gap-2 align-items-end">
      <div style="width:120px">
        <label class="form-label small fw-semibold">Tháng</label>
        <select name="month" class="form-select form-select-sm">
          <% for(let m=1; m<=12; m++) { %>
            <option value="<%= m %>" <%= m === targetMonth ? 'selected' : '' %>>Tháng <%= m %></option>
          <% } %>
        </select>
      </div>
      <div style="width:120px">
        <label class="form-label small fw-semibold">Năm</label>
        <input type="number" name="year" class="form-control form-control-sm" value="<%= targetYear %>" min="2020" max="2050">
      </div>
      <button type="submit" class="btn btn-primary btn-sm px-3"><i class="fas fa-search me-1"></i>Xem</button>
    </form>
  </div>
</div>

<style>
  .ts-table { min-width: 1200px; }
  .ts-table th, .ts-table td { padding: 4px; vertical-align: middle; text-align: center; border: 1px solid #dee2e6; }
  .ts-table th.sticky-col, .ts-table td.sticky-col { 
    position: sticky; left: 0; background-color: #fff; z-index: 1; border-right: 2px solid #ccc; text-align: left; padding-left: 10px; width: 180px; 
  }
  .ts-table thead th.sticky-col { z-index: 2; background-color: #f8f9fa; }
  
  .code-cell { font-size: 11px; font-weight: bold; width: 30px; height: 30px; display: inline-flex; align-items: center; justify-content: center; border-radius: 4px; }
  .code-- { color: #ccc; }
  .code-plus { background-color: #e6f4ea; color: #1e8e3e; }
  .code-a { background-color: #e8f0fe; color: #1a73e8; }
  .code-cta { background-color: #fce8e6; color: #d93025; }
  .code-p { background-color: #fef7e0; color: #f29900; }
  .code-nl { background-color: #f3e8fd; color: #a142f4; }
  .code-o { background-color: #fff0f5; color: #e91e63; }
  .code-k { background-color: #f1f3f4; color: #5f6368; }
</style>

<div class="card border-0 shadow-sm">
  <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
    <h6 class="mb-0 fw-semibold">Bảng chấm công tổng hợp tháng <%= targetMonth %>/<%= targetYear %></h6>
    <span class="badge bg-primary text-white"><%= officers.length %> Cán bộ</span>
  </div>
  <div class="card-body p-0">
    <div class="table-responsive" style="max-height: 600px; overflow-y: auto;">
      <table class="table table-hover mb-0 ts-table">
        <thead class="table-light position-sticky top-0 shadow-sm" style="z-index: 3;">
          <tr>
            <th class="sticky-col">Họ và tên</th>
            <% for(let d=1; d<=daysInMonth; d++) { %>
              <th style="width: 35px; font-size: 11px;"><%= d %></th>
            <% } %>
            <th style="width: 60px;">Xem</th>
          </tr>
        </thead>
        <tbody>
          <% if (officers && officers.length > 0) { %>
            <% officers.forEach(off => { %>
              <% 
                 const ts = tsMap[off._id.toString()]; 
                 const records = ts && ts.records ? ts.records : [];
                 const rMap = {};
                 records.forEach(r => rMap[r.day] = r);
              %>
              <tr>
                <td class="sticky-col">
                  <div class="fw-bold" style="font-size: 13px; color: #2c3e50;"><%= off.hoTen %></div>
                  <div class="small text-muted" style="font-size: 10px;"><%= off.capBac || 'CBCS' %></div>
                </td>
                <% for(let d=1; d<=daysInMonth; d++) { %>
                  <% 
                     const r = rMap[d]; 
                     let codeStr = '-';
                     let cssClass = 'code--';
                     let title = '';
                     if (r) {
                       codeStr = r.code;
                       if(codeStr === '+') cssClass = 'code-plus';
                       else if(codeStr === 'A') cssClass = 'code-a';
                       else if(codeStr === 'CT-A') cssClass = 'code-cta';
                       else if(codeStr === 'P') cssClass = 'code-p';
                       else if(codeStr === 'NL') cssClass = 'code-nl';
                       else if(codeStr === 'O') cssClass = 'code-o';
                       else if(codeStr === 'K') cssClass = 'code-k';
                       
                       if(r.note) title = r.note;
                     }
                  %>
                  <td>
                    <div class="code-cell <%= cssClass %>" title="<%= title %>">
                      <%= codeStr %>
                    </div>
                  </td>
                <% } %>
                <td>
                  <a href="/timesheets/<%= targetYear %>/<%= targetMonth %>/<%= off._id %>" class="btn btn-sm btn-light border text-primary px-2 py-0">
                    <i class="fas fa-edit" style="font-size: 10px;"></i>
                  </a>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr><td colspan="<%= daysInMonth + 2 %>" class="text-center py-4 text-muted">Không có dữ liệu cán bộ.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
