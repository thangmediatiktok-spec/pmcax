<%- include('../partials/header', { activeMenu: 'users' }) %>
<%- include('../partials/flash') %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h5 class="fw-bold mb-0"><i class="fas fa-users-cog text-danger me-2"></i>Tài khoản hệ thống</h5>
    <small class="text-muted">Quản lý tài khoản và phân quyền truy cập</small>
  </div>
  <div class="d-flex gap-2">
    <button type="button" class="btn btn-outline-success btn-sm" data-bs-toggle="modal" data-bs-target="#importExcelModal">
      <i class="fas fa-file-excel me-1"></i>Nhập từ Excel
    </button>
    <a href="/users/create" class="btn btn-danger btn-sm"><i class="fas fa-plus me-1"></i>Thêm tài khoản</a>
  </div>
</div>

<!-- Mobile List View -->
<div class="d-md-none mb-3">
  <% if (users.length === 0) { %>
    <div class="text-center py-5 text-muted bg-white rounded shadow-sm">
      <i class="fas fa-users-slash fa-2x mb-2 d-block opacity-25"></i>
      Không có tài khoản nào
    </div>
  <% } else { %>
    <div class="list-group shadow-sm border-0">
      <% users.forEach(u => { %>
        <%
          let roleBadge = 'secondary';
          let roleText = 'Cán bộ';
          if(u.role === 'admin') { roleBadge = 'danger'; roleText = 'Admin'; }
          else if(u.role === 'truong_cax') { roleBadge = 'warning text-dark'; roleText = 'Trưởng CAX'; }
          else if(u.role === 'pho_cax') { roleBadge = 'primary'; roleText = 'Phó Trưởng CAX'; }
        %>
        <div class="list-group-item py-3 border-bottom">
          <div class="d-flex justify-content-between align-items-start mb-2">
            <div>
              <div class="fw-bold" style="color: #1a2235; font-size: 15px;">
                <i class="fas fa-user-circle text-muted me-1"></i> <%= u.username %>
              </div>
              <div class="small text-muted"><%= u.hoTen %></div>
            </div>
            <span class="badge bg-<%= roleBadge %>"><%= roleText %></span>
          </div>
          
          <div class="mb-3 d-flex justify-content-between align-items-center">
            <span class="badge bg-<%= u.trangThai ? 'success' : 'secondary' %>"><%= u.trangThai ? 'Hoạt động' : 'Đã khóa' %></span>
            <small class="text-muted" style="font-size: 11px;">
              <i class="fas fa-clock me-1"></i><%= u.lastLogin ? new Date(u.lastLogin).toLocaleDateString('vi-VN') : 'Chưa ĐN' %>
            </small>
          </div>
          
          <div class="d-flex gap-2">
            <a href="/users/<%= u._id %>/edit" class="btn btn-sm btn-outline-warning flex-grow-1"><i class="fas fa-edit"></i> Sửa</a>
            <% if (u._id.toString() !== currentUser._id.toString()) { %>
              <form action="/users/<%= u._id %>/toggle-lock" method="POST" class="flex-grow-1 d-flex">
                <button type="submit" class="btn btn-sm w-100 <%= u.trangThai ? 'btn-outline-secondary' : 'btn-outline-success' %>">
                  <i class="fas <%= u.trangThai ? 'fa-lock' : 'fa-unlock' %>"></i> <%= u.trangThai ? 'Khóa' : 'Mở' %>
                </button>
              </form>
              <form action="/users/<%= u._id %>/reset-2fa" method="POST" class="delete-form flex-grow-1 d-flex" data-confirm="Tắt 2FA cho <%= u.username %>?">
                <button type="submit" class="btn btn-sm btn-outline-info w-100" title="Tắt 2FA">
                  <i class="fas fa-mobile-alt"></i><i class="fas fa-slash fa-stack-1x" style="font-size:0.6em;color:red;opacity:0.8;"></i>
                </button>
              </form>
              <form action="/users/<%= u._id %>?_method=DELETE" method="POST" class="delete-form" data-confirm="Xóa tài khoản <%= u.username %>?">
                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
              </form>
            <% } %>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<!-- Desktop Table View -->
<div class="card border-0 shadow-sm d-none d-md-block">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0 align-middle">
        <thead class="table-light">
          <tr>
            <th class="ps-3">Tài khoản</th>
            <th>Họ tên</th>
            <th>Email</th>
            <th>Vai trò</th>
            <th>Trạng thái</th>
            <th>Đăng nhập gần nhất</th>
            <th>Thao tác</th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach(u => { %>
          <tr>
            <td class="ps-3"><span class="fw-semibold"><i class="fas fa-user-circle text-muted me-2"></i><%= u.username %></span></td>
            <td><small><%= u.hoTen %></small></td>
            <td><small class="text-muted"><%= u.email || '-' %></small></td>
            <%
              let roleBadge = 'secondary';
              let roleText = 'Cán bộ';
              if(u.role === 'admin') { roleBadge = 'danger'; roleText = 'Admin'; }
              else if(u.role === 'truong_cax') { roleBadge = 'warning text-dark'; roleText = 'Trưởng CAX'; }
              else if(u.role === 'pho_cax') { roleBadge = 'primary'; roleText = 'Phó Trưởng CAX'; }
            %>
            <td><span class="badge bg-<%= roleBadge %>"><%= roleText %></span></td>
            <td><span class="badge bg-<%= u.trangThai ? 'success' : 'secondary' %>"><%= u.trangThai ? 'Hoạt động' : 'Đã khóa' %></span></td>
            <td><small class="text-muted"><%= u.lastLogin ? new Date(u.lastLogin).toLocaleString('vi-VN') : 'Chưa đăng nhập' %></small></td>
            <td>
              <div class="d-flex gap-1">
                <a href="/users/<%= u._id %>/edit" class="btn btn-sm btn-outline-warning" title="Chỉnh sửa"><i class="fas fa-edit"></i></a>
                <% if (u._id.toString() !== currentUser._id.toString()) { %>
                <form action="/users/<%= u._id %>/reset-2fa" method="POST" class="d-inline delete-form" data-confirm="Tắt 2FA cho <%= u.username %>? Người này sẽ phải quét mã QR mới vào lần đăng nhập tới.">
                  <button type="submit" class="btn btn-sm btn-outline-info" title="Tắt 2FA (Reset Google Authenticator)">
                    <i class="fas fa-mobile-alt"></i><i class="fas fa-slash fa-stack-1x" style="font-size:0.6em;color:red;opacity:0.8;"></i>
                  </button>
                </form>
                <form action="/users/<%= u._id %>/toggle-lock" method="POST" class="d-inline">
                  <button type="submit" class="btn btn-sm <%= u.trangThai ? 'btn-outline-secondary' : 'btn-outline-success' %>" title="<%= u.trangThai ? 'Khóa tài khoản' : 'Mở khóa tài khoản' %>">
                    <i class="fas <%= u.trangThai ? 'fa-lock' : 'fa-unlock' %>"></i>
                  </button>
                </form>
                <form action="/users/<%= u._id %>?_method=DELETE" method="POST" class="delete-form" data-confirm="Xóa tài khoản <%= u.username %>?">
                  <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa"><i class="fas fa-trash"></i></button>
                </form>
                <% } %>
              </div>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Import Excel Modal -->
<div class="modal fade" id="importExcelModal" tabindex="-1" aria-labelledby="importExcelModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form action="/users/import-excel" method="POST" enctype="multipart/form-data">
        <div class="modal-header bg-success text-white">
          <h5 class="modal-title" id="importExcelModalLabel"><i class="fas fa-file-excel me-2"></i>Nhập tài khoản từ Excel</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label for="excelFile" class="form-label fw-bold">Chọn file Excel (.xlsx)</label>
            <input class="form-control" type="file" id="excelFile" name="excelFile" accept=".xlsx, .xls" required>
          </div>
          <div class="alert alert-info mb-0 small">
            <i class="fas fa-info-circle me-1"></i>Vui lòng sử dụng file mẫu chuẩn của hệ thống để nhập dữ liệu. 
            Nếu bạn chưa có file mẫu, hãy tải về tại đây:
            <div class="mt-2 text-center">
              <a href="/users/template-excel" class="btn btn-sm btn-outline-primary">
                <i class="fas fa-download me-1"></i>Tải file Excel mẫu
              </a>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
          <button type="submit" class="btn btn-success"><i class="fas fa-upload me-1"></i>Nhập dữ liệu</button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
