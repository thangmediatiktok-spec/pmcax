<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body class="bg-light">

<div class="wrapper d-flex">
  <!-- Sidebar -->
  <nav id="sidebar" class="sidebar bg-dark text-white">
    <div class="sidebar-header p-3 border-bottom border-secondary">
      <div class="d-flex align-items-center gap-2">
        <img src="/img/caxlogo.png" alt="Logo" width="40" onerror="this.style.display='none'">
        <div>
          <div class="fw-bold text-warning" style="font-size:13px">CÔNG AN XÃ</div>
          <div style="font-size:11px;color:#adb5bd">Hệ thống quản lý CBCS</div>
        </div>
      </div>
    </div>

    <ul class="nav flex-column p-2 mt-2">
      <li class="nav-item">
        <a href="/dashboard" class="nav-link text-white rounded mb-1 <%= locals.activeMenu === 'dashboard' ? 'active-menu' : '' %>">
          <i class="fas fa-tachometer-alt me-2"></i> Dashboard
        </a>
      </li>
      <li class="nav-item">
        <a href="/officers" class="nav-link text-white rounded mb-1 <%= locals.activeMenu === 'officers' ? 'active-menu' : '' %>">
          <i class="fas fa-user-shield me-2"></i> Cán bộ chiến sĩ
        </a>
      </li>
      <li class="nav-item">
        <a href="/ranks" class="nav-link text-white rounded mb-1 <%= locals.activeMenu === 'ranks' ? 'active-menu' : '' %>">
          <i class="fas fa-medal me-2"></i> Quản lý cấp bậc
        </a>
      </li>
      <% if (currentUser && currentUser.role === 'admin') { %>
      <li class="nav-item">
        <a href="/users" class="nav-link text-white rounded mb-1 <%= locals.activeMenu === 'users' ? 'active-menu' : '' %>">
          <i class="fas fa-users-cog me-2"></i> Tài khoản hệ thống
        </a>
      </li>
      <% } %>
    </ul>

    <div class="position-absolute bottom-0 w-100 p-3 border-top border-secondary">
      <div class="d-flex align-items-center justify-content-between">
        <div>
          <div class="fw-semibold" style="font-size:13px"><%= currentUser ? currentUser.hoTen : '' %></div>
          <span class="badge <%= currentUser && currentUser.role === 'admin' ? 'bg-danger' : currentUser && currentUser.role === 'editor' ? 'bg-warning text-dark' : 'bg-secondary' %>" style="font-size:10px">
            <%= currentUser ? currentUser.role.toUpperCase() : '' %>
          </span>
        </div>
        <a href="/logout" class="btn btn-sm btn-outline-light" title="Đăng xuất">
          <i class="fas fa-sign-out-alt"></i>
        </a>
      </div>
    </div>
  </nav>

  <!-- Main Content -->
  <div class="main-content flex-grow-1">
    <!-- Topbar -->
    <nav class="navbar navbar-expand navbar-light bg-white shadow-sm px-3" style="min-height:56px">
      <button class="btn btn-sm btn-outline-secondary me-3" id="sidebarToggle">
        <i class="fas fa-bars"></i>
      </button>
      <span class="navbar-brand mb-0 fw-semibold text-secondary" style="font-size:15px"><%= title %></span>
      <div class="ms-auto d-flex align-items-center gap-2">
        <span class="text-muted" style="font-size:13px"><i class="fas fa-user-circle me-1"></i><%= currentUser ? currentUser.username : '' %></span>
      </div>
    </nav>

    <div class="p-4">
      <!-- Flash messages -->
      <% if (success && success.length > 0) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          <i class="fas fa-check-circle me-2"></i><%= success[0] %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% } %>
      <% if (error && error.length > 0) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <i class="fas fa-exclamation-circle me-2"></i><%= error[0] %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% } %>

      <%- body %>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
  document.getElementById('sidebarToggle')?.addEventListener('click', () => {
    document.getElementById('sidebar').classList.toggle('sidebar-collapsed');
  });
  setTimeout(() => {
    document.querySelectorAll('.alert').forEach(a => {
      const bsAlert = bootstrap.Alert.getOrCreateInstance(a);
      bsAlert.close();
    });
  }, 4000);
</script>
</body>
</html>
