<%- include('../partials/header', { activeMenu: 'telegram-config' }) %>
<%- include('../partials/flash') %>

<div class="row mb-4 align-items-center">
  <div class="col-sm-8">
    <h4 class="mb-0 fw-bold"><i class="fab fa-telegram text-primary me-2"></i>Cấu hình Bot Telegram</h4>
    <p class="text-muted small mb-0 mt-1">Quản lý các lệnh (commands) trả lời tự động trên nhóm</p>
  </div>
  <div class="col-sm-4 text-sm-end mt-3 mt-sm-0">
    <button class="btn btn-primary shadow-sm" data-bs-toggle="modal" data-bs-target="#addCommandModal">
      <i class="fas fa-plus me-1"></i>Thêm Lệnh tĩnh
    </button>
  </div>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="bg-light">
          <tr>
            <th class="px-4 py-3" style="width: 150px;">Lệnh (Command)</th>
            <th class="py-3">Mô tả</th>
            <th class="py-3">Loại</th>
            <th class="py-3 text-center">Trạng thái</th>
            <th class="py-3 text-center">Giờ hẹn</th>
            <th class="px-4 py-3 text-end" style="width: 120px;">Thao tác</th>
          </tr>
        </thead>
        <tbody>
          <% if (commands.length === 0) { %>
            <tr>
              <td colspan="5" class="text-center py-5 text-muted">
                <i class="fas fa-robot mb-3" style="font-size: 40px; opacity: 0.5;"></i>
                <br>Chưa có câu lệnh nào được thiết lập.
              </td>
            </tr>
          <% } else { %>
            <% commands.forEach(cmd => { %>
              <tr>
                <td class="px-4 fw-bold text-primary">/<%= cmd.command %></td>
                <td>
                  <div class="fw-medium text-dark"><%= cmd.description %></div>
                  <% if (cmd.type === 'static' && cmd.staticText) { %>
                    <div class="small text-muted mt-1 text-truncate" style="max-width: 300px;"><i class="fas fa-reply me-1"></i><%= cmd.staticText %></div>
                  <% } %>
                </td>
                <td>
                  <% if (cmd.type === 'dynamic') { %>
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill"><i class="fas fa-cogs me-1"></i>Lệnh hệ thống</span>
                  <% } else { %>
                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill"><i class="fas fa-font me-1"></i>Văn bản tĩnh</span>
                  <% } %>
                </td>
                <td class="text-center">
                  <% if (cmd.scheduleTime) { %>
                    <span class="badge bg-warning-subtle text-dark border border-warning-subtle"><i class="far fa-clock me-1"></i><%= cmd.scheduleTime %></span>
                  <% } else { %>
                    <span class="text-muted small">Không</span>
                  <% } %>
                </td>
                <td class="text-center">
                  <form action="/telegram-config/<%= cmd._id %>/toggle?_method=PUT" method="POST" class="d-inline">
                    <button type="submit" class="btn btn-sm shadow-none p-0">
                      <% if (cmd.isActive) { %>
                        <i class="fas fa-toggle-on text-success" style="font-size: 24px;"></i>
                      <% } else { %>
                        <i class="fas fa-toggle-off text-muted" style="font-size: 24px;"></i>
                      <% } %>
                    </button>
                  </form>
                </td>
                <td class="px-4 text-end">
                  <div class="d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-sm btn-light border text-warning shadow-none" 
                            data-bs-toggle="modal" data-bs-target="#editCommandModal"
                            onclick="fillEditModal('<%= cmd._id %>', '<%= cmd.description %>', '<%= cmd.type %>', `<%= cmd.staticText ? cmd.staticText.replace(/`/g, '\\`') : '' %>`, '<%= cmd.scheduleTime || '' %>')">
                      <i class="fas fa-edit"></i>
                    </button>
                    <% if (cmd.type === 'static') { %>
                      <form action="/telegram-config/<%= cmd._id %>?_method=DELETE" method="POST" onsubmit="confirmAction(event, this, 'Bạn có chắc chắn muốn xóa lệnh /<%= cmd.command %> này?', 'Xóa', '#d33');">
                        <button type="submit" class="btn btn-sm btn-light border text-danger shadow-none"><i class="fas fa-trash"></i></button>
                      </form>
                    <% } else { %>
                      <button type="button" class="btn btn-sm btn-light border text-muted shadow-none" disabled title="Không thể xóa lệnh hệ thống"><i class="fas fa-trash"></i></button>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Modal Thêm -->
<div class="modal fade" id="addCommandModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow">
      <div class="modal-header bg-primary text-white border-0">
        <h5 class="modal-title fw-bold"><i class="fas fa-plus-circle me-2"></i>Thêm lệnh tĩnh</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <form action="/telegram-config" method="POST">
        <div class="modal-body p-4">
          <div class="alert alert-info small border-0 shadow-sm mb-4">
            <i class="fas fa-info-circle me-2"></i>Lệnh tĩnh là lệnh mà khi người dùng gõ, Bot sẽ trả lời bằng một đoạn văn bản cố định do bạn thiết lập.
          </div>
          
          <div class="mb-3">
            <label class="form-label fw-semibold small text-muted">Tên lệnh (Command) <span class="text-danger">*</span></label>
            <div class="input-group">
              <span class="input-group-text bg-light">/</span>
              <input type="text" class="form-control" name="command" required placeholder="vidu: wifi" pattern="[a-zA-Z0-9_]+" title="Chỉ chứa chữ không dấu, số và gạch dưới">
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold small text-muted">Mô tả ngắn gọn <span class="text-danger">*</span></label>
            <input type="text" class="form-control" name="description" required placeholder="Xem mật khẩu wifi cơ quan">
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold small text-muted">Văn bản Bot sẽ trả lời <span class="text-danger">*</span></label>
            <textarea class="form-control" name="staticText" rows="4" required placeholder="Mật khẩu wifi: 12345678&#10;Ghi chú: HTML tag như <b>in đậm</b> được hỗ trợ."></textarea>
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold small text-muted">Giờ tự động chạy (Tùy chọn)</label>
            <input type="time" class="form-control" name="scheduleTime">
            <div class="form-text small">Nếu đặt, lệnh này sẽ tự động chạy vào giờ này hàng ngày và gửi lên nhóm.</div>
          </div>
        </div>
        <div class="modal-footer bg-light border-0">
          <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Hủy</button>
          <button type="submit" class="btn btn-primary fw-medium"><i class="fas fa-save me-1"></i>Lưu lệnh</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Modal Sửa -->
<div class="modal fade" id="editCommandModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow">
      <div class="modal-header bg-warning text-dark border-0">
        <h5 class="modal-title fw-bold"><i class="fas fa-edit me-2"></i>Sửa lệnh</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form id="editCommandForm" method="POST">
        <div class="modal-body p-4">
          <div class="mb-3">
            <label class="form-label fw-semibold small text-muted">Mô tả ngắn gọn <span class="text-danger">*</span></label>
            <input type="text" class="form-control" name="description" id="editDesc" required>
          </div>
          <div class="mb-3" id="editStaticTextBox">
            <label class="form-label fw-semibold small text-muted">Văn bản Bot sẽ trả lời <span class="text-danger">*</span></label>
            <textarea class="form-control" name="staticText" id="editStaticText" rows="4"></textarea>
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold small text-muted">Giờ tự động chạy (Tùy chọn)</label>
            <input type="time" class="form-control" name="scheduleTime" id="editScheduleTime">
            <div class="form-text small">Nếu đặt, lệnh này sẽ tự động chạy vào giờ này hàng ngày và gửi lên nhóm.</div>
          </div>
        </div>
        <div class="modal-footer bg-light border-0">
          <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Hủy</button>
          <button type="submit" class="btn btn-warning fw-medium"><i class="fas fa-check me-1"></i>Cập nhật</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  function confirmAction(event, form, text, confirmBtnText, color) {
    event.preventDefault();
    Swal.fire({
      title: 'Xác nhận',
      text: text,
      icon: 'warning',
      showCancelButton: true,
      confirmButtonColor: color || '#d33',
      cancelButtonColor: '#6c757d',
      confirmButtonText: confirmBtnText || 'Đồng ý',
      cancelButtonText: 'Hủy'
    }).then((result) => {
      if (result.isConfirmed) {
        form.submit();
      }
    });
  }

  function fillEditModal(id, desc, type, staticText, scheduleTime) {
    document.getElementById('editCommandForm').action = '/telegram-config/' + id + '?_method=PUT';
    document.getElementById('editDesc').value = desc;
    document.getElementById('editScheduleTime').value = scheduleTime;
    
    const staticBox = document.getElementById('editStaticTextBox');
    const staticInput = document.getElementById('editStaticText');
    
    if (type === 'static') {
      staticBox.style.display = 'block';
      staticInput.value = staticText;
      staticInput.setAttribute('required', 'required');
    } else {
      staticBox.style.display = 'none';
      staticInput.value = '';
      staticInput.removeAttribute('required');
    }
  }
</script>

<%- include('../partials/footer') %>
