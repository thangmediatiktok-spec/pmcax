<!DOCTYPE html>
<html lang="vi">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Đăng nhập - CAX Chư A Thai</title>
  <link rel="icon" href="/images/logo.png" type="image/png">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">
  <style>
    body {
      background: url('/images/trong-dong.png') center/100vmin no-repeat fixed, linear-gradient(135deg, #1a2235 0%, #2d3f5e 100%);
      background-blend-mode: soft-light;
      min-height: 100vh;
    }

    .login-card {
      border-radius: 16px;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
    }

    .badge-logo {
      width: 80px;
      height: 80px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 16px;
    }

    .form-control:focus {
      border-color: #e63946;
      box-shadow: 0 0 0 .2rem rgba(230, 57, 70, .25);
    }

    .btn-login {
      background: linear-gradient(135deg, #e63946, #c1121f);
      border: none;
      padding: 12px;
      font-weight: 600;
      letter-spacing: .5px;
    }

    .btn-login:hover {
      background: linear-gradient(135deg, #c1121f, #9d0208);
    }

    .left-side {
      background: url('/images/trong-dong.png') center/100vmin no-repeat fixed, linear-gradient(135deg, #1a2235 0%, #2d3f5e 100%);
      background-blend-mode: soft-light;
      min-height: 100vh;
      position: relative;
    }

    .left-content {
      position: absolute;
      bottom: 10%;
      left: 10%;
      color: rgba(255, 255, 255, 0.8);
    }

    .right-side {
      min-height: 100vh;
      background-color: #ffffff;
    }
  </style>
</head>

<body>
  <div class="container-fluid p-0">
    <div class="row g-0">
      <!-- Left Background (Hidden on small screens) -->
      <div class="col-md-7 col-lg-8 d-none d-md-block left-side">
        <div class="left-content">
          <h2 class="fw-bold text-white mb-2">HỆ THỐNG PHẦN MỀM</h2>
          <h4 class="text-warning mb-0">PHỤC VỤ NQ57</h4>
          <p class="mt-2 small opacity-75">Công an xã Chư A Thai - Đơn vị vững mạnh, toàn diện</p>
        </div>
      </div>

      <!-- Right Form Area -->
      <div class="col-md-5 col-lg-4 d-flex align-items-center justify-content-center right-side shadow-lg">
        <div class="w-100 p-4 p-sm-5" style="max-width: 480px;">
          <div class="text-center mb-5">
            <div class="badge-logo shimmer-img-container">
              <img src="/images/logo.png" alt="Logo" style="width:100%;height:100%;object-fit:contain;">
            </div>
            <h4 class="fw-bold shimmer-text-dark mb-1">CÔNG AN XÃ<br>CHƯ A THAI</h4>
            <p class="text-muted small mb-0">KỶ LUẬT NHẤT - TRUNG THÀNH NHẤT - GẦN DÂN NHẤT</p>
          </div>

          <% if (error && error.length> 0) { %>
            <div class="alert alert-danger py-2">
              <i class="fas fa-exclamation-circle me-2"></i>
              <%= error[0] %>
            </div>
            <% } %>
              <% if (success && success.length> 0) { %>
                <div class="alert alert-success py-2">
                  <i class="fas fa-check-circle me-2"></i>
                  <%= success[0] %>
                </div>
                <% } %>

                  <form action="/login" method="POST">
                    <div class="mb-3">
                      <label class="form-label fw-semibold small">Tên đăng nhập</label>
                      <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i
                            class="fas fa-user text-muted"></i></span>
                        <input type="text" name="username" class="form-control border-start-0"
                          placeholder="Nhập tên đăng nhập" required autofocus>
                      </div>
                    </div>
                    <div class="mb-4">
                      <label class="form-label fw-semibold small">Mật khẩu</label>
                      <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i
                            class="fas fa-lock text-muted"></i></span>
                        <input type="password" name="password" id="passwordInput"
                          class="form-control border-start-0 border-end-0" placeholder="Nhập mật khẩu" required>
                        <button type="button" class="btn btn-light border border-start-0" onclick="togglePwd()">
                          <i class="fas fa-eye text-muted" id="eyeIcon"></i>
                        </button>
                      </div>
                    </div>
                    <button type="submit" class="btn btn-login btn-danger w-100 text-white rounded-3 shadow-sm">
                      <i class="fas fa-sign-in-alt me-2"></i>Đăng nhập
                    </button>
                  </form>

                  <p class="text-center text-muted small mt-5 mb-0">
                    <i class="fas fa-shield-alt text-success me-1"></i>Hệ thống chức năng phục vụ NQ57
                  </p>
                  <p class="text-center text-muted small mt-1" style="font-size: 11px;">
                    © 2026 L9GPROMAX - CAX CHƯ A THAI
                  </p>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    function togglePwd() {
      const inp = document.getElementById('passwordInput');
      const icon = document.getElementById('eyeIcon');
      if (inp.type === 'password') { inp.type = 'text'; icon.className = 'fas fa-eye-slash text-muted'; }
      else { inp.type = 'password'; icon.className = 'fas fa-eye text-muted'; }
    }
  </script>
</body>

</html>