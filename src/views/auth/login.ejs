<!DOCTYPE html>
<html lang="vi">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Đăng nhập - CAX Chư A Thai</title>
  <link rel="icon" href="/images/logo.png" type="image/png">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">
  <style>
    body {
      background: #f4f6f9;
      min-height: 100vh;
    }

    .login-card {
      border-radius: 16px;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
    }

    .badge-logo {
      width: 80px;
      height: 80px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 16px;
    }

    .form-control:focus {
      border-color: #e63946;
      box-shadow: 0 0 0 .2rem rgba(230, 57, 70, .25);
    }

    .btn-login {
      background: linear-gradient(135deg, #e63946, #c1121f);
      border: none;
      padding: 12px;
      font-weight: 600;
      letter-spacing: .5px;
    }

    .btn-login:hover {
      background: linear-gradient(135deg, #c1121f, #9d0208);
    }

    .left-side {
      background: url('/images/background-2-9-29.jpg') center/cover no-repeat;
      min-height: 100vh;
      position: relative;
    }

    .left-side::before {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(to right, rgba(15, 20, 35, 0.85) 0%, rgba(15, 20, 35, 0.6) 50%, rgba(15, 20, 35, 0.2) 100%);
      z-index: 1;
    }

    .left-content {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      left: 10%;
      z-index: 2;
      width: 80%;
    }

    .right-side {
      min-height: 100vh;
      background-color: #ffffff;
    }

    .slogan-text {
      font-size: 3.5rem;
      font-weight: 900;
      text-transform: uppercase;
      background: linear-gradient(120deg, #ffffff 0%, #ffffff 35%, #ffeb3b 50%, #ffffff 65%, #ffffff 100%);
      background-size: 200% auto;
      color: #fff;
      background-clip: text;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      animation: slideShine 4s linear infinite;
      filter: drop-shadow(0 4px 10px rgba(0,0,0,0.6));
      line-height: 1.3;
      margin-bottom: 2rem;
    }

    @keyframes slideShine {
      0% { background-position: 200% center; }
      100% { background-position: -200% center; }
    }

    .nq57-badge span {
      animation: pulseGlow 2s infinite;
      display: inline-block;
    }
    
    @keyframes pulseGlow {
      0% { box-shadow: 0 0 0 0 rgba(220, 53, 69, 0.7); }
      70% { box-shadow: 0 0 0 15px rgba(220, 53, 69, 0); }
      100% { box-shadow: 0 0 0 0 rgba(220, 53, 69, 0); }
    }

    .glass-panel {
      background: rgba(255, 255, 255, 0.1);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      border: 1px solid rgba(255, 255, 255, 0.2);
      box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.3);
      padding: 1.5rem;
      border-radius: 16px;
      display: inline-block;
    }
  </style>
</head>

<body>
  <div class="container-fluid p-0">
    <div class="row g-0">
      <!-- Left Background (Hidden on small screens) -->
      <div class="col-md-7 col-lg-8 d-none d-md-block left-side">
        <div class="left-content">
          <div class="nq57-badge mb-4">
            <span class="badge bg-danger fs-5 shadow px-4 py-2 rounded-pill border border-2 border-warning">
              <i class="fas fa-star text-warning me-2"></i>THỰC HIỆN NHIỆM VỤ NQ57
            </span>
          </div>
          
          <h1 class="slogan-text">
            TRUNG THÀNH NHẤT<br>
            KỶ LUẬT NHẤT<br>
            GẦN DÂN NHẤT
          </h1>
          
          <div class="glass-panel mt-3">
            <h4 class="fw-bold text-white mb-1">HỆ THỐNG PHẦN MỀM CAX CHƯ A THAI</h4>
            <p class="mb-0 text-white-50">Đơn vị vững mạnh, toàn diện</p>
          </div>
        </div>
      </div>

      <!-- Right Form Area -->
      <div class="col-md-5 col-lg-4 d-flex align-items-center justify-content-center right-side shadow-lg">
        <div class="w-100 p-4 p-sm-5" style="max-width: 480px;">
          <div class="text-center mb-5">
            <div class="badge-logo shimmer-img-container">
              <img src="/images/logo.png" alt="Logo" style="width:100%;height:100%;object-fit:contain;">
            </div>
            <h4 class="fw-bold shimmer-text-dark mb-1">CÔNG AN XÃ<br>CHƯ A THAI</h4>
            <p class="text-muted small mb-0">KỶ LUẬT NHẤT - TRUNG THÀNH NHẤT - GẦN DÂN NHẤT</p>
          </div>

          <% if (error && error.length> 0) { %>
            <div class="alert alert-danger py-2">
              <i class="fas fa-exclamation-circle me-2"></i>
              <%= error[0] %>
            </div>
            <% } %>
              <% if (success && success.length> 0) { %>
                <div class="alert alert-success py-2">
                  <i class="fas fa-check-circle me-2"></i>
                  <%= success[0] %>
                </div>
                <% } %>

                  <form action="/login" method="POST">
                    <div class="mb-3">
                      <label class="form-label fw-semibold small">Tên đăng nhập</label>
                      <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i
                            class="fas fa-user text-muted"></i></span>
                        <input type="text" name="username" class="form-control border-start-0"
                          placeholder="Nhập tên đăng nhập" required autofocus>
                      </div>
                    </div>
                    <div class="mb-4">
                      <label class="form-label fw-semibold small">Mật khẩu</label>
                      <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i
                            class="fas fa-lock text-muted"></i></span>
                        <input type="password" name="password" id="passwordInput"
                          class="form-control border-start-0 border-end-0" placeholder="Nhập mật khẩu" required>
                        <button type="button" class="btn btn-light border border-start-0" onclick="togglePwd()">
                          <i class="fas fa-eye text-muted" id="eyeIcon"></i>
                        </button>
                      </div>
                    </div>
                    <button type="submit" class="btn btn-login btn-danger w-100 text-white rounded-3 shadow-sm">
                      <i class="fas fa-sign-in-alt me-2"></i>Đăng nhập
                    </button>
                  </form>

                  <p class="text-center text-muted small mt-5 mb-0">
                    <i class="fas fa-shield-alt text-success me-1"></i>Hệ thống chức năng phục vụ NQ57
                  </p>
                  <p class="text-center text-muted small mt-1" style="font-size: 11px;">
                    © 2026 L9GPROMAX - CAX CHƯ A THAI
                  </p>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    function togglePwd() {
      const inp = document.getElementById('passwordInput');
      const icon = document.getElementById('eyeIcon');
      if (inp.type === 'password') { inp.type = 'text'; icon.className = 'fas fa-eye-slash text-muted'; }
      else { inp.type = 'password'; icon.className = 'fas fa-eye text-muted'; }
    }
  </script>
</body>

</html>