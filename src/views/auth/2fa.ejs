<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <style>
    body { background: #f8f9fa; height: 100vh; display: flex; align-items: center; justify-content: center; }
    .card { border: none; border-radius: 12px; box-shadow: 0 10px 30px rgba(0,0,0,0.05); overflow: hidden; max-width: 400px; width: 100%; }
    .card-header { background: linear-gradient(135deg, #1a2235, #2d3748); color: white; text-align: center; padding: 30px 20px; border-bottom: none; }
    .btn-login { background: linear-gradient(135deg,#e63946,#c1121f); border: none; padding: 12px; font-weight: 600; letter-spacing: .5px; width: 100%; color: white; border-radius: 8px; }
    .btn-login:hover { background: linear-gradient(135deg,#c1121f,#a00f1a); color: white; }
    .otp-input { text-align: center; font-size: 24px; letter-spacing: 8px; font-weight: bold; }
  </style>
</head>
<body>
  <div class="container d-flex justify-content-center">
    <div class="card">
      <div class="card-header">
        <h4 class="mb-0 fw-bold"><i class="fas fa-shield-alt me-2"></i>Xác thực 2 bước</h4>
        <p class="mb-0 mt-2 text-light" style="opacity: 0.8; font-size: 14px;">Mở ứng dụng Google Authenticator để lấy mã</p>
      </div>
      <div class="card-body p-4">
        <%- include('../partials/flash') %>
        <form action="/login/2fa" method="POST">
          <div class="mb-4">
            <label class="form-label text-muted fw-semibold">Mã xác thực 6 số</label>
            <input type="text" name="token" class="form-control form-control-lg otp-input" required autofocus autocomplete="off" maxlength="6" pattern="[0-9]{6}">
          </div>
          <button type="submit" class="btn btn-login"><i class="fas fa-check-circle me-2"></i>Xác nhận</button>
        </form>
        <div class="text-center mt-4">
          <a href="/login" class="text-decoration-none text-muted" style="font-size: 13px;"><i class="fas fa-arrow-left me-1"></i>Quay lại đăng nhập</a>
        </div>
      </div>
    </div>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
