<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="icon" type="image/x-icon" href="/images/logo.png">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <style>
    body {
      background-color: #f8f9fa;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background-image: url('/images/trong-dong.png');
      background-size: 600px;
      background-position: center;
      background-repeat: no-repeat;
      background-attachment: fixed;
    }
    body::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(248, 249, 250, 0.9);
      z-index: -1;
    }
    .auth-card {
      border: none;
      border-radius: 15px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.08);
      overflow: hidden;
      background: white;
    }
    .card-header-auth {
      padding: 30px;
      text-align: center;
      background: linear-gradient(135deg, #6f1a24, #a42a38);
      color: white;
    }
    .pin-input-group {
      display: flex;
      justify-content: center;
      gap: 10px;
      margin-bottom: 30px;
    }
    .pin-input {
      width: 50px;
      height: 60px;
      font-size: 24px;
      text-align: center;
      border: 2px solid #ced4da;
      border-radius: 8px;
      font-weight: bold;
      color: #2c3e50;
      transition: all 0.3s;
    }
    .pin-input:focus {
      border-color: #6f1a24;
      box-shadow: 0 0 0 0.25rem rgba(111, 26, 36, 0.25);
      outline: none;
    }
    .btn-submit {
      padding: 12px;
      font-weight: 600;
      border-radius: 8px;
      background-color: #6f1a24;
      border-color: #6f1a24;
    }
    .btn-submit:hover {
      background-color: #531821;
      border-color: #531821;
    }
  </style>
</head>
<body>
  <div class="container" style="max-width: 450px;">
    <div class="auth-card card">
      <div class="card-header-auth">
        <i class="fas fa-user-lock fa-3x mb-3 text-warning"></i>
        <h4 class="mb-0 fw-bold">Xác thực Mã PIN</h4>
        <p class="mb-0 mt-2 text-light" style="opacity: 0.9; font-size: 14px;">Khu vực truy cập dữ liệu Tối mật</p>
      </div>
      
      <div class="card-body p-4 p-md-5">
        <%- include('../partials/flash') %>
        
        <p class="text-center text-muted mb-4">
          Vui lòng nhập Mã PIN bảo mật cấp 2 để mở khóa hồ sơ cán bộ.
        </p>

        <form action="/unlock-pin" method="POST" id="pinForm">
          <input type="hidden" name="pinCode" id="pinCodeInput">
          
          <div class="pin-input-group" id="pin-group">
            <input type="password" class="pin-input" maxlength="1" pattern="\d*" inputmode="numeric" required>
            <input type="password" class="pin-input" maxlength="1" pattern="\d*" inputmode="numeric" required>
            <input type="password" class="pin-input" maxlength="1" pattern="\d*" inputmode="numeric" required>
            <input type="password" class="pin-input" maxlength="1" pattern="\d*" inputmode="numeric" required>
            <input type="password" class="pin-input" maxlength="1" pattern="\d*" inputmode="numeric" required>
            <input type="password" class="pin-input" maxlength="1" pattern="\d*" inputmode="numeric" required>
          </div>
          
          <button type="submit" class="btn btn-primary btn-submit w-100">
            <i class="fas fa-unlock me-2"></i> Mở khóa
          </button>
          
          <div class="text-center mt-3">
            <a href="/dashboard" class="text-muted text-decoration-none small"><i class="fas fa-arrow-left me-1"></i> Quay lại Bảng điều khiển</a>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script>
    const group = document.getElementById('pin-group');
    const inputs = group.querySelectorAll('.pin-input');
    const hiddenInput = document.getElementById('pinCodeInput');
    
    inputs.forEach((input, index) => {
      input.addEventListener('input', function(e) {
        this.value = this.value.replace(/[^0-9]/g, '');
        if (this.value && index < inputs.length - 1) {
          inputs[index + 1].focus();
        }
        updateHiddenInput();
      });
      
      input.addEventListener('keydown', function(e) {
        if (e.key === 'Backspace' && !this.value && index > 0) {
          inputs[index - 1].focus();
          inputs[index - 1].value = '';
        }
        updateHiddenInput();
      });
      
      input.addEventListener('paste', function(e) {
        e.preventDefault();
        const pastedData = e.clipboardData.getData('text').replace(/[^0-9]/g, '').slice(0, 6);
        if (pastedData) {
          for (let i = 0; i < pastedData.length; i++) {
            if (inputs[i]) inputs[i].value = pastedData[i];
          }
          if (pastedData.length < 6) {
            inputs[pastedData.length].focus();
          } else {
            inputs[5].focus();
            document.getElementById('pinForm').submit();
          }
          updateHiddenInput();
        }
      });
    });
    
    function updateHiddenInput() {
      let pin = '';
      inputs.forEach(input => pin += input.value);
      hiddenInput.value = pin;
      
      if (pin.length === 6) {
        setTimeout(() => document.getElementById('pinForm').submit(), 300);
      }
    }
    
    document.querySelector('.pin-input').focus();
  </script>
</body>
</html>
